function increaseProgress(id){

  const note =
    notes.find(n=>n.id === id);

  if(!note){
    return;
  }

  note.progress =
    Math.min((note.progress || 0) + 25,100);

  saveData();

  renderNotes();

  renderDashboard();

  openNote(id);

  showToast("Fortschritt aktualisiert ✓");

}

function deleteNote(id){

  if(!confirm("Diesen Lernzettel wirklich löschen?")){
    return;
  }

  notes =
    notes.filter(note=>note.id !== id);

  saveData();

  renderNotes();

