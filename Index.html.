  localStorage.removeItem("studysnap_tasks");
  localStorage.removeItem("studysnap_stats");
  localStorage.removeItem("studysnap_profile_name");

  location.reload();

}

/* =========================================
   INITIALIZE
========================================= */

renderDashboard();

renderNotes();

renderVocabulary();

renderExams();

renderTasks();

loadSettings();

updateTimerDisplay();

startFlashcards();

/* Update countdowns every minute */

setInterval(()=>{

  if(
    document
      .getElementById("exams")
      .classList
      .contains("active")
  ){

    renderExams();

  }

},60000);

</script>

