<script>

/* =========================================
   DATA
========================================= */

let notes = JSON.parse(localStorage.getItem("studysnap_notes") || "[]");
let exams = JSON.parse(localStorage.getItem("studysnap_exams") || "[]");
let vocabulary = JSON.parse(localStorage.getItem("studysnap_vocab") || "[]");
let tasks = JSON.parse(localStorage.getItem("studysnap_tasks") || "[]");

let stats = JSON.parse(localStorage.getItem("studysnap_stats") || JSON.stringify({
  quiz:0,
  xp:0,
  streak:1,
  minutes:0
}));

let selectedImages = [];

let flashIndex = 0;

let vocabFlashIndex = 0;

/* =========================================
   SAVE DATA
========================================= */

function saveData(){

  localStorage.setItem(
    "studysnap_notes",
    JSON.stringify(notes)
  );

  localStorage.setItem(
    "studysnap_exams",
    JSON.stringify(exams)
  );

  localStorage.setItem(
    "studysnap_vocab",
    JSON.stringify(vocabulary)
  );

  localStorage.setItem(
    "studysnap_tasks",
    JSON.stringify(tasks)
  );

  localStorage.setItem(
    "studysnap_stats",
    JSON.stringify(stats)
  );

}

/* =========================================
   PAGE NAVIGATION
========================================= */

function showPage(pageId, clickedButton){

  document.querySelectorAll(".page").forEach(page=>{
    page.classList.remove("active");
  });

  const page = document.getElementById(pageId);

  if(page){
    page.classList.add("active");
  }

  document.querySelectorAll(".nav button,.mobile-nav button")
    .forEach(button=>{
      button.classList.remove("active");
    });

  if(clickedButton){
    clickedButton.classList.add("active");
  }

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

  if(pageId==="dashboard"){
    renderDashboard();
  }

  if(pageId==="notes"){
    renderNotes();
  }

  if(pageId==="vocabulary"){
    renderVocabulary();
  }

  if(pageId==="exams"){
    renderExams();
  }

  if(pageId==="tasks"){
    renderTasks();
  }

}

/* =========================================
   TOAST
========================================= */

let toastTimer;

function showToast(message){

  const toast = document.getElementById("toast");

  toast.textContent = message;

  toast.classList.add("show");

  clearTimeout(toastTimer);

  toastTimer = setTimeout(()=>{
    toast.classList.remove("show");
  },2500);

}

/* =========================================
   UPLOAD
========================================= */

function openUpload(){

  document.getElementById("uploadModal")
    .classList.add("show");

}

function closeUpload(){

  document.getElementById("uploadModal")
    .classList.remove("show");

  selectedImages = [];

  document.getElementById("previewGrid").innerHTML = "";

  document.getElementById("noteTitle").value = "";

  document.getElementById("noteContent").value = "";

}

function handleFiles(files){

  Array.from(files).forEach(file=>{

    if(file.type.startsWith("image/")){

      const reader = new FileReader();

      reader.onload = function(e){

        selectedImages.push({
          name:file.name,
          data:e.target.result
        });

        renderPreviews();

      };

      reader.readAsDataURL(file);

    }else{

      selectedImages.push({
        name:file.name,
        data:null,
        pdf:true
      });

      renderPreviews();

    }

  });

}

function renderPreviews(){

  const grid = document.getElementById("previewGrid");

  grid.innerHTML = "";

  selectedImages.forEach((image,index)=>{

    const div = document.createElement("div");

    div.className = "preview";

    if(image.data){

      div.innerHTML = 
        <img src="${image.data}" alt="">
        <button onclick="removeImage(${index})">×</button>
      ;

    }else{

      div.innerHTML = 
        <div style="
          height:100%;
          display:flex;
          align-items:center;
          justify-content:center;
          flex-direction:column;
          gap:5px;
          font-size:12px;
        ">
          📄
          <span>${escapeHTML(image.name)}</span>
        </div>
        <button onclick="removeImage(${index})">×</button>
      ;

    }

    grid.appendChild(div);

  });

}

function removeImage(index){

  selectedImages.splice(index,1);

  renderPreviews();

}

/* =========================================
   NOTES
========================================= */

function saveNote(){

  const title =
    document.getElementById("noteTitle").value.trim();

  const subject =
    document.getElementById("noteSubject").value;

  const content =
    document.getElementById("noteContent").value.trim();

  if(!title){

    showToast("Bitte gib einen Titel ein.");

    return;

  }

  const note = {

    id:Date.now(),

    title:title,

    subject:subject,

    content:content,

    images:selectedImages,

    progress:0,

    createdAt:new Date().toISOString()

  };

  notes.unshift(note);

  saveData();

  addActivity(
    "📚",
    "${title}" wurde gespeichert.,
    "Gerade eben"
  );

  closeUpload();

  renderNotes();

  renderDashboard();

  showToast("Lernzettel gespeichert ✓");

}

function renderNotes(){

  const container =
    document.getElementById("notesList");

  if(!notes.length){

    container.innerHTML = 
      <div class="card empty" style="grid-column:1/-1">
        <div class="empty-icon">📚</div>
        <strong>Noch keine Lernzettel</strong>
        <p style="margin-top:5px">
          Füge deinen ersten Lernzettel hinzu.
        </p>
      </div>
    ;

    return;

  }

  container.innerHTML = notes.map(note=>`

    <div class="card note-card">

      <div class="note-top">

        <div class="subject-icon">
