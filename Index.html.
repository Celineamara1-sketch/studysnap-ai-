function getSubjectIcon(subject){

  const icons={

    "Biologie":"🧬",
    "Mathe":"🧮",
    "Englisch":"🇬🇧",
    "Deutsch":"📖",
    "Geschichte":"🏛️",
    "Physik":"⚡",
    "Chemie":"🧪"

  };

  return icons[subject] || "📚";

}

function formatDate(date){

  if(!date) return "";

  const d =
    new Date(date+"T00:00:00");

  return d.toLocaleDateString(
    "de-DE",
    {
      day:"2-digit",
      month:"2-digit",
      year:"numeric"
    }
  );

}

function escapeHTML(text){

  return String(text ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}

