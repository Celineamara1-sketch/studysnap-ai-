<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudySnap AI</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f6f7fb;
  --card:#ffffff;
  --text:#171923;
  --muted:#777b87;
  --border:#e8e9ef;
  --primary:#6257d8;
  --primary-light:#eeecff;
  --green:#35a86b;
  --red:#e95d67;
  --shadow:0 8px 30px rgba(30,30,60,.06);
}

body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,textarea,select{
  font:inherit;
}

button{
  cursor:pointer;
  border:none;
}

.app{
  display:flex;
  min-height:100vh;
}

.sidebar{
  width:230px;
  background:#fff;
  border-right:1px solid var(--border);
  padding:24px 16px;
  position:fixed;
  height:100vh;
  z-index:5;
}

.logo{
  font-size:22px;
  font-weight:800;
  margin-bottom:28px;
}

.logo span{
  color:var(--primary);
}

.nav button{
  display:block;
  width:100%;
  padding:12px;
  margin:4px 0;
  background:none;
  border-radius:10px;
  text-align:left;
  color:#555;
}

.nav button:hover,
.nav button.active{
  background:var(--primary-light);
  color:var(--primary);
  font-weight:600;
}

.main{
  margin-left:230px;
  width:calc(100% - 230px);
  padding:28px;
  max-width:1400px;
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:25px;
}

.search{
  background:#fff;
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px 15px;
  width:320px;
  outline:none;
}

.page{
  display:none;
}

.page.active{
  display:block;
}

.hero{
  background:linear-gradient(135deg,#eeeaff,#fff);
  border:1px solid #e5e1ff;
  border-radius:20px;
  padding:30px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin-bottom:22px;
}

.hero h1{
  font-size:28px;
  margin-bottom:8px;
}

.hero p{
  color:var(--muted);
  max-width:600px;
  line-height:1.5;
}

.buttons{
  display:flex;
  gap:10px;
  margin-top:18px;
  flex-wrap:wrap;
}

.primary-btn,
.secondary-btn,
.danger-btn{
  padding:11px 15px;
  border-radius:10px;
  font-weight:600;
}

.primary-btn{
  background:var(--primary);
  color:#fff;
}

.secondary-btn{
  background:#fff;
  border:1px solid var(--border);
}

.danger-btn{
  background:#fff0f1;
  color:var(--red);
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin-bottom:22px;
}

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px;
  box-shadow:var(--shadow);
}

.stat-number{
  font-size:25px;
  font-weight:800;
  margin-top:5px;
}

.muted{
  color:var(--muted);
  font-size:13px;
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:25px 0 13px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.note-card{
  cursor:pointer;
  transition:.2s;
}

.note-card:hover{
  transform:translateY(-2px);
}

.note-card h3{
  margin:10px 0 5px;
}

.subject-icon{
  font-size:28px;
}

.progress-bar{
  height:7px;
  background:#eee;
  border-radius:10px;
  overflow:hidden;
  margin:13px 0;
}

.progress-fill{
  height:100%;
  background:var(--primary);
}

.note-footer{
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-size:12px;
}

.tool-card{
  cursor:pointer;
  transition:.2s;
}

.tool-card:hover{
  transform:translateY(-2px);
  border-color:#d8d3ff;
}

.tool-icon{
  font-size:30px;
  margin-bottom:10px;
}

.form{
  display:grid;
  gap:12px;
  max-width:650px;
}

input,
textarea,
select{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:10px;
  background:#fff;
  outline:none;
}

textarea{
  min-height:130px;
  resize:vertical;
}

.list{
  display:grid;
  gap:10px;
  margin-top:15px;
}

.row{
  background:#fff;
  border:1px solid var(--border);
  border-radius:12px;
  padding:14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.empty{
  text-align:center;
  color:var(--muted);
  padding:30px;
}

.empty-icon{
  font-size:35px;
  margin-bottom:8px;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.35);
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:20;
}

.modal.show{
  display:flex;
}

.modal-box{
  background:#fff;
  border-radius:18px;
  padding:22px;
  width:min(650px,100%);
  max-height:90vh;
  overflow:auto;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close-btn{
  background:#f2f2f5;
  width:35px;
  height:35px;
  border-radius:50%;
}

.preview-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:10px;
}

.preview{
  position:relative;
  height:110px;
  border-radius:12px;
  overflow:hidden;
  background:#f2f2f5;
}

.preview img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.preview button{
  position:absolute;
  right:5px;
  top:5px;
  width:25px;
  height:25px;
  border-radius:50%;
  background:#fff;
  color:var(--red);
}

.viewer{
  display:none;
}

.viewer.show{
  display:block;
}

.viewer-images{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
  margin-top:15px;
}

.viewer-images img{
  width:100%;
  border-radius:12px;
  max-height:400px;
  object-fit:contain;
  background:#f5f5f5;
}

.flashcard-wrap{
  max-width:500px;
  margin:25px auto;
}

.flashcard{
  height:260px;
  perspective:1000px;
  cursor:pointer;
}

.flash-inner{
  width:100%;
  height:100%;
  position:relative;
  transition:.5s;
  transform-style:preserve-3d;
}

.flashcard.flipped .flash-inner{
  transform:rotateY(180deg);
}

.flash-face{
  position:absolute;
  width:100%;
  height:100%;
  backface-visibility:hidden;
  background:#fff;
  border:1px solid var(--border);
  border-radius:20px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:20px;
  box-shadow:var(--shadow);
}

.flash-back{
  transform:rotateY(180deg);
}

.flash-face strong{
  font-size:24px;
  margin-top:12px;
  text-align:center;
}

.countdown{
  color:var(--primary);
  font-size:21px;
  font-weight:800;
  margin:15px 0;
}

.done{
  text-decoration:line-through;
  opacity:.55;
}

.toast{
  position:fixed;
  bottom:25px;
  left:50%;
  transform:translateX(-50%);
  background:#171923;
  color:#fff;
  padding:12px 18px;
  border-radius:10px;
  display:none;
  z-index:50;
}

.toast.show{
  display:block;
}

.mobile-nav{
  display:none;
}

@media(max-width:800px){

  .sidebar{
    display:none;
  }

  .main{
    margin:0;
    width:100%;
    padding:18px;
    padding-bottom:85px;
  }

  .top{
    display:block;
  }

  .top h2{
    margin-bottom:12px;
  }

  .search{
    width:100%;
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .grid{
    grid-template-columns:1fr;
  }

  .hero{
    display:block;
  }

  .hero h1{
    font-size:24px;
  }

  .mobile-nav{
    display:flex;
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:#fff;
    border-top:1px solid var(--border);
    justify-content:space-around;
    padding:8px;
    z-index:10;
  }

  .mobile-nav button{
    background:none;
    color:#555;
    font-size:11px;
  }

  .preview-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .viewer-images{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar">

<div class="logo">
Study<span>Snap</span> AI
</div>

<nav class="nav">

<button class="active" onclick="showPage('dashboard',this)">
🏠 Übersicht
</button>

<button onclick="showPage('notes',this)">
📚 Meine Lernzettel
</button>

<button onclick="showPage('quiz',this)">
🧠 Quiz
</button>

<button onclick="showPage('cards',this)">
🃏 Karteikarten
</button>

<button onclick="showPage('vocab',this)">
🇬🇧 Vokabeln
</button>

<button onclick="showPage('questions',this)">
💬 StudySnap fragen
</button>

<button onclick="showPage('exams',this)">
📅 Klassenarbeiten
</button>

<button onclick="showPage('tasks',this)">
✅ Aufgaben
</button>

<button onclick="showPage('timer',this)">
⏱️ Lern-Timer
</button>

</nav>
</aside>


<main class="main">

<div class="top">

<h2>StudySnap AI</h2>

<input
class="search"
id="searchInput"
placeholder="🔎 Lernzettel suchen..."
oninput="searchNotes()"
>

</div>


<!-- DASHBOARD -->

<section id="dashboard" class="page active">

<div class="hero">

<div>

<h1>Schön, dass du da bist. 👋</h1>

<p>
Verwandle deine Lernzettel in Quizfragen,
Karteikarten und verständliche Zusammenfassungen –
alles an einem Ort.
</p>

<div class="buttons">

<button
class="primary-btn"
onclick="openUpload()"
>
＋ Lernzettel hinzufügen
</button>

<button
class="secondary-btn"
onclick="showPage('notes')"
>
Meine Lernzettel
</button>

</div>

</div>

<div class="card">

<div class="muted">
Gesamtfortschritt
</div>

<div
class="stat-number"
id="overallProgress"
>
0%
</div>

</div>

</div>


<div class="stats">

<div class="card">
<div class="muted">📚 Lernzettel</div>
<div class="stat-number" id="statNotes">0</div>
</div>

<div class="card">
<div class="muted">🧠 Quizze gemacht</div>
<div class="stat-number" id="statQuiz">0</div>
</div>

<div class="card">
<div class="muted">🔥 Lernserie</div>
<div class="stat-number" id="statStreak">0</div>
</div>

<div class="card">
<div class="muted">⭐ XP gesammelt</div>
<div class="stat-number" id="statXP">0</div>
</div>

</div>


<div class="section-title">
<h2>Meine Lernzettel</h2>
</div>

<div
id="dashboardNotes"
class="grid"
>
</div>


<div class="section-title">
<h2>Schnell lernen</h2>
</div>

<div class="grid">

<div
class="card tool-card"
onclick="openQuiz()"
>
<div class="tool-icon">🧠</div>
<h3>Quiz erstellen</h3>
<p class="muted">
Erstelle ein Quiz zu deinem Lernstoff.
</p>
</div>


<div
class="card tool-card"
onclick="showPage('cards')"
>
<div class="tool-icon">🃏</div>
<h3>Karteikarten</h3>
<p class="muted">
Lerne mit Frage und Antwort.
</p>
</div>


<div
class="card tool-card"
onclick="showPage('vocab')"
>
<div class="tool-icon">🇬🇧</div>
<h3>Vokabeln lernen</h3>
<p class="muted">
Übe deine eigenen Vokabeln.
</p>
</div>

</div>

</section>


<!-- LERNZETTEL -->

<section id="notes" class="page">

<h1>📚 Meine Lernzettel</h1>

<p class="muted">
Hier werden deine gespeicherten Lernzettel angezeigt.
</p>

<div
id="notesList"
class="grid"
style="margin-top:20px"
>
</div>

<div
id="noteViewer"
class="viewer card"
style="margin-top:20px"
>
</div>

</section>


<!-- QUIZ -->

<section id="quiz" class="page">

<h1>🧠 Quiz</h1>

<p class="muted">
Teste dein Wissen.
</p>

<div
id="quizSetup"
class="card"
style="margin-top:20px"
>

<div class="form">

<select id="quizNote">
<option value="">Lernzettel auswählen</option>
</select>

<button
class="primary-btn"
onclick="startQuiz()"
>
Quiz starten
</button>

</div>

</div>

<div
id="quizArea"
style="margin-top:20px"
>
</div>

</section>


<!-- KARTEIKARTEN -->

<section id="cards" class="page">

<h1>🃏 Karteikarten</h1>

<p class="muted">
Klicke auf eine Karte, um die Antwort zu sehen.
</p>

<div
class="flashcard-wrap"
>

<div
id="flashcard"
class="flashcard"
onclick="flipCard()"
>

<div class="flash-inner">

<div class="flash-face">

<span>Frage</span>

<strong id="flashQuestion">
Was ist Lernen?
</strong>

</div>

<div class="flash-face flash-back">

<span>Antwort</span>

<strong id="flashAnswer">
Wissen und Fähigkeiten aufbauen.
</strong>

</div>

</div>

</div>

<div
class="buttons"
style="justify-content:center"
>

<button
class="secondary-btn"
onclick="nextFlashcard()"
>
Nächste Karte →
</button>

</div>

</div>

</section>


<!-- VOKABELN -->

<section id="vocab" class="page">

<h1>🇬🇧 Vokabeln</h1>

<p class="muted">
Erstelle deine eigenen Vokabelkarten.
</p>

<div
class="card"
style="margin-top:20px"
>

<div class="form">

<input
id="vocabWord"
placeholder="Englisch, z. B. beautiful"
>

<input
id="vocabTranslation"
placeholder="Deutsch, z. B. schön"
>

<button
class="primary-btn"
onclick="addVocabulary()"
>
＋ Vokabel hinzufügen
</button>

</div>

</div>

<div
id="vocabList"
class="list"
>
</div>

</section>


<!-- FRAGEN -->

<section id="questions" class="page">

<h1>💬 StudySnap fragen</h1>

<p class="muted">
Stelle Fragen zu deinem Lernstoff.
</p>

<div
class="card"
style="margin-top:20px"
>

<div class="form">

<textarea
id="questionInput"
placeholder="Was möchtest du wissen?"
></textarea>

<button
class="primary-btn"
onclick="askStudySnap()"
>
Frage stellen
</button>

</div>

<div
id="questionAnswer"
style="margin-top:15px"
>
</div>

</div>

</section>


<!-- KLASSENARBEITEN -->

<section id="exams" class="page">

<h1>📅 Klassenarbeiten</h1>

<p class="muted">
Behalte deine nächsten Tests im Blick.
</p>

<div
class="card"
style="margin-top:20px"
>

<div class="form">

<input
id="examSubject"
placeholder="Fach, z. B. Mathe"
>

<input
id="examTopic"
placeholder="Thema"
>

<input
id="examDate"
type="date"
>

<button
class="primary-btn"
onclick="addExam()"
>
＋ Klassenarbeit hinzufügen
</button>

</div>

</div>

<div
id="examList"
class="grid"
style="margin-top:20px"
>
</div>

</section>


<!-- AUFGABEN -->

<section id="tasks" class="page">

<h1>✅ Aufgaben</h1>

<p class="muted">
Behalte deine Aufgaben im Überblick.
</p>

<div
class="card"
style="margin-top:20px"
>

<div class="form">

<input
id="taskInput"
placeholder="Neue Aufgabe..."
>

<button
class="primary-btn"
onclick="addTask()"
>
＋ Aufgabe hinzufügen
</button>

</div>

</div>

<div
id="taskList"
class="list"
>
</div>

</section>


<!-- TIMER -->

<section id="timer" class="page">

<h1>⏱️ Lern-Timer</h1>

<p class="muted">
Konzentriert lernen – eine Einheit nach der anderen.
</p>

<div
class="card"
style="max-width:500px;text-align:center;margin-top:20px"
>

<div
id="timerDisplay"
style="font-size:55px;font-weight:800"
>
25:00
</div>

<div
class="buttons"
style="justify-content:center"
>

<button
id="timerButton"
class="primary-btn"
onclick="toggleTimer()"
>
▶ Start
</button>

<button
class="secondary-btn"
onclick="resetTimer()"
>
↻ Reset
</button>

</div>

</div>

</section>

</main>

</div>


<!-- MOBILE NAVIGATION -->

<div class="mobile-nav">

<button onclick="showPage('dashboard')">
🏠<br>Home
</button>

<button onclick="showPage('notes')">
📚<br>Lernzettel
</button>

<button onclick="showPage('quiz')">
🧠<br>Quiz
</button>

<button onclick="showPage('vocab')">
🇬🇧<br>Vokabeln
</button>

<button onclick="showPage('exams')">
📅<br>Tests
</button>

</div>


<!-- UPLOAD MODAL -->

<div
id="uploadModal"
class="modal"
>

<div class="modal-box">

<div class="modal-header">

<h2>📚 Lernzettel hinzufügen</h2>

<button
class="close-btn"
onclick="closeUpload()"
>
✕
</button>

</div>

<div class="form">

<input
id="noteTitle"
placeholder="Titel, z. B. Das Auge"
>

<select id="noteSubject">

<option>Biologie</option>
<option>Mathe</option>
<option>Englisch</option>
<option>Deutsch</option>
<option>Geschichte</option>
<option>Physik</option>
<option>Chemie</option>
<option>Sonstiges</option>

</select>

<textarea
id="noteContent"
placeholder="Lernstoff hier eingeben..."
></textarea>

<label class="secondary-btn" style="text-align:center">

📷 Fotos / PDF auswählen

<input
id="noteFiles"
type="file"
accept="image/*,.pdf"
multiple
style="display:none"
onchange="previewFiles()"
>

</label>

<div
id="previewGrid"
class="preview-grid"
>
</div>

<button
class="primary-btn"
onclick="saveNote()"
>
Lernzettel speichern
</button>

</div>

</div>

</div>


<!-- TOAST -->

<div
id="toast"
class="toast"
></div>
