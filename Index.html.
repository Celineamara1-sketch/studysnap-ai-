function startQuiz(){

  const selected =
    document.getElementById("quizNote").value;

  if(!selected){

    showToast("Wähle zuerst einen Lernzettel.");

    return;

  }

  const note =
    notes.find(n=>String(n.id) === String(selected));

  if(!note){
    return;
  }

  const topic =
    note.title;

  quizQuestions = [

    {
      q:`Was ist eine wichtige Grundidee bei „${topic}“?`,
      a:"Versuche, die wichtigsten Begriffe und Zusammenhänge aus deinem Lernstoff zu erklären."
    },

    {
      q:`Wie kannst du „${topic}“ am besten lernen?`,
      a:"Durch aktives Wiederholen, eigene Erklärungen und Selbsttests."
    },

    {
      q:`Was solltest du vor einer Klassenarbeit zu „${topic}“ machen?`,
      a:"Den Lernstoff wiederholen und dich selbst mit Fragen testen."
    }

  ];

  quizIndex = 0;
  quizScore = 0;

  renderQuiz();

}

function renderQuiz(){

  const area =
    document.getElementById("quizArea");

  if(quizIndex >= quizQuestions.length){

    stats.quiz++;
    stats.xp += quizScore * 10 + 10;

    saveData();

    area.innerHTML = `

      <div class="card empty">

        <div class="empty-icon">🏆</div>

        <h2>Quiz geschafft!</h2>

        <p style="margin-top:8px">
