<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f7f7f5">
<title>StudySnap AI – Smarter lernen</title>

<style>
:root{
  --bg:#f7f7f5;
  --surface:#ffffff;
  --surface-2:#f1f1ee;
  --text:#20211f;
  --muted:#777a74;
  --line:#e7e7e2;
  --accent:#5d55e8;
  --accent-soft:#ecebff;
  --green:#3d8b68;
  --shadow:0 10px 35px rgba(30,30,25,.07);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,
input,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
  border:none;
}

.app{
  display:flex;
  min-height:100vh;
}

/* SIDEBAR */

.sidebar{
  width:245px;
  background:white;
  border-right:1px solid var(--line);
  padding:25px 16px;
  display:flex;
  flex-direction:column;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
}

.logo{
  font-size:22px;
  font-weight:750;
  padding:0 12px 30px;
  letter-spacing:-.5px;
}

.logo span{
  color:var(--accent);
}

.nav{
  display:flex;
  flex-direction:column;
  gap:5px;
}

.nav button{
  width:100%;
  text-align:left;
  background:transparent;
  color:#656760;
  padding:12px 13px;
  border-radius:12px;
  transition:.2s;
}

.nav button:hover,
.nav button.active{
  background:var(--accent-soft);
  color:var(--accent);
}

.profile{
  margin-top:auto;
  padding:14px;
  border-top:1px solid var(--line);
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:36px;
  height:36px;
  border-radius:50%;
  background:var(--accent-soft);
  display:grid;
  place-items:center;
  color:var(--accent);
  font-weight:700;
}

.profile small{
  color:var(--muted);
}

/* MAIN */

.main{
  margin-left:245px;
  width:calc(100% - 245px);
  padding:25px 32px 50px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.search{
  width:330px;
  background:white;
  border:1px solid var(--line);
  border-radius:12px;
  padding:11px 15px;
  outline:none;
}

.search:focus{
  border-color:var(--accent);
}

.top-button{
  background:var(--accent);
  color:white;
  border-radius:11px;
  padding:11px 16px;
  font-weight:600;
}

/* HERO */

.hero{
  background:white;
  border:1px solid var(--line);
  border-radius:20px;
  padding:28px;
  display:flex;
  justify-content:space-between;
  gap:25px;
  box-shadow:var(--shadow);
  margin-bottom:28px;
}

.hero h1{
  font-size:30px;
  letter-spacing:-1px;
  margin-bottom:8px;
}

.hero p{
  color:var(--muted);
  max-width:650px;
  line-height:1.55;
}

.hero-actions{
  display:flex;
  gap:10px;
  margin-top:20px;
}

.primary{
  background:var(--accent);
  color:white;
  padding:12px 17px;
  border-radius:11px;
  font-weight:600;
}

.secondary{
  background:var(--surface-2);
  color:var(--text);
  padding:12px 17px;
  border-radius:11px;
  font-weight:600;
}

.progress-box{
  min-width:180px;
  background:var(--surface-2);
  border-radius:16px;
  padding:18px;
}

.progress-number{
  font-size:30px;
  font-weight:750;
}

.progress-label{
  color:var(--muted);
  font-size:13px;
  margin-bottom:12px;
}

.progress-bar{
  height:8px;
  background:#ddd;
  border-radius:10px;
  overflow:hidden;
}

.progress-fill{
  width:68%;
  height:100%;
  background:var(--accent);
}

/* SECTIONS */

.section{
  margin-bottom:30px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.section-head h2{
  font-size:19px;
}

.section-head button{
  background:none;
  color:var(--accent);
}

/* NOTES */

.notes{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.note-card{
  background:white;
  border:1px solid var(--line);
  border-radius:16px;
  padding:19px;
  transition:.2s;
}

.note-card:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow);
}

.note-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  background:var(--accent-soft);
  display:grid;
  place-items:center;
  margin-bottom:14px;
}

.note-card h3{
  font-size:16px;
  margin-bottom:6px;
}

.note-card p{
  font-size:13px;
  color:var(--muted);
}

.note-progress{
  margin-top:15px;
}

.note-progress-top{
  display:flex;
  justify-content:space-between;
  font-size:12px;
  color:var(--muted);
  margin-bottom:5px;
}

.small-bar{
  height:6px;
  background:#e8e8e4;
  border-radius:10px;
  overflow:hidden;
}

.small-fill{
  height:100%;
  background:var(--accent);
}

/* TOOLS */

.tools{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.tool{
  background:white;
  border:1px solid var(--line);
  border-radius:16px;
  padding:19px;
  text-align:left;
  transition:.2s;
}

.tool:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow);
}

.tool-icon{
  font-size:22px;
  margin-bottom:12px;
}

.tool h3{
  font-size:15px;
  margin-bottom:5px;
}

.tool p{
  font-size:12px;
  color:var(--muted);
}

/* LOWER */

.lower{
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:18px;
}

.panel{
  background:white;
  border:1px solid var(--line);
  border-radius:17px;
  padding:20px;
}

.panel h2{
  font-size:18px;
  margin-bottom:15px;
}

.upload{
  border:2px dashed #d8d8d3;
  border-radius:14px;
  padding:30px;
  text-align:center;
}

.upload-icon{
  font-size:30px;
  margin-bottom:10px;
}

.upload p{
  color:var(--muted);
  font-size:13px;
  margin:6px 0 15px;
}

.upload input{
  display:none;
}

.upload-label{
  display:inline-block;
  background:var(--accent);
  color:white;
  padding:10px 16px;
  border-radius:10px;
  font-weight:600;
  cursor:pointer;
}

.activity{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.activity-item{
  display:flex;
  gap:11px;
  align-items:center;
}

.activity-dot{
  width:9px;
  height:9px;
  background:var(--accent);
  border-radius:50%;
}

.activity-item div:last-child{
  font-size:13px;
}

.activity-item small{
  display:block;
  color:var(--muted);
  margin-top:2px;
}

/* MODAL */

.modal-bg{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.35);
  z-index:50;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal{
  width:min(600px,100%);
  background:white;
  border-radius:20px;
  padding:25px;
  box-shadow:0 20px 60px rgba(0,0,0,.2);
}

.modal h2{
  margin-bottom:7px;
}

.modal-sub{
  color:var(--muted);
  font-size:14px;
  margin-bottom:20px;
}

.modal input,
.modal textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:11px;
  padding:12px;
  outline:none;
  margin-bottom:12px;
}

.modal textarea{
  min-height:150px;
  resize:vertical;
}

.modal input:focus,
.modal textarea:focus{
  border-color:var(--accent);
}

.modal-buttons{
  display:flex;
  justify-content:flex-end;
  gap:10px;
}

/* TOAST */

.toast{
  position:fixed;
  bottom:25px;
  right:25px;
  background:#20211f;
  color:white;
  padding:13px 17px;
  border-radius:11px;
  opacity:0;
  pointer-events:none;
  transform:translateY(10px);
  transition:.25s;
  z-index:100;
}

.toast.show{
  opacity:1;
  transform:translateY(0);
}

/* MOBILE */

.mobile-nav{
  display:none;
}

@media(max-width:900px){

  .sidebar{
    display:none;
  }

  .main{
    margin-left:0;
    width:100%;
    padding:18px 16px 85px;
  }

  .topbar{
    gap:10px;
  }

  .search{
    width:100%;
  }

  .top-button{
    display:none;
  }

  .hero{
    flex-direction:column;
  }

  .progress-box{
    min-width:0;
  }

  .notes{
    grid-template-columns:1fr;
  }

  .tools{
    grid-template-columns:repeat(2,1fr);
  }

  .lower{
    grid-template-columns:1fr;
  }

  .mobile-nav{
    display:flex;
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:white;
    border-top:1px solid var(--line);
    height:65px;
    z-index:40;
    justify-content:space-around;
  }

  .mobile-nav button{
    background:none;
    color:var(--muted);
    font-size:11px;
  }

  .mobile-nav button.active{
    color:var(--accent);
  }
}

@media(max-width:500px){

  .hero h1{
    font-size:25px;
  }

  .tools{
    grid-template-columns:1fr 1fr;
  }

  .hero-actions{
    flex-direction:column;
  }

  .primary,
  .secondary{
    width:100%;
  }
}
</style>
</head>

