          ${formatDate(exam.date)}
          ${exam.time ? " • "+exam.time+" Uhr" : ""}
        </div>

        <h3>
          ${escapeHTML(exam.subject)}
        </h3>

        <div class="exam-topic">
          ${escapeHTML(exam.topic || "Kein Thema angegeben")}
        </div>

