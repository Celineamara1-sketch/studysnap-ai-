<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f7f7f5">
<title>StudySnap AI – Smarter lernen</title>

<style>
:root{
  --bg:#f7f7f5;
  --surface:#ffffff;
  --surface-2:#f1f1ee;
  --text:#20211f;
  --muted:#777a74;
  --line:#e7e7e2;
  --accent:#5d55e8;
  --accent-soft:#ecebff;
  --green:#3d8b68;
  --shadow:0 10px 35px rgba(30,30,25,.07);
}

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,
input,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.app{
  min-height:100vh;
}

/* SIDEBAR */

.sidebar{
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  width:245px;
  background:#fff;
  border-right:1px solid var(--line);
  padding:25px 18px;
  display:flex;
  flex-direction:column;
  z-index:10;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:20px;
  font-weight:800;
  margin-bottom:35px;
}

.logo-mark{
  width:34px;
  height:34px;
  border-radius:11px;
  background:var(--accent);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

.nav{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.nav button{
  border:0;
  background:transparent;
  color:#666861;
  text-align:left;
  padding:12px 14px;
  border-radius:12px;
  font-size:14px;
}

.nav button:hover,
.nav button.active{
  background:var(--accent-soft);
  color:var(--accent);
}

.profile{
  margin-top:auto;
  border-top:1px solid var(--line);
  padding-top:18px;
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:38px;
  height:38px;
  border-radius:50%;
  background:#e9e8ff;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--accent);
  font-weight:700;
}

.profile-text{
  font-size:13px;
}

.profile-text strong{
  display:block;
}

.profile-text span{
  color:var(--muted);
}

/* MAIN */

.main{
  margin-left:245px;
  padding:28px 35px 50px;
  max-width:1500px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:28px;
}

.search{
  width:min(440px,100%);
  background:#fff;
  border:1px solid var(--line);
  border-radius:13px;
  padding:12px 15px;
  outline:none;
}

.search:focus{
  border-color:var(--accent);
}

.hero{
  display:grid;
  grid-template-columns:1fr 280px;
  gap:20px;
  margin-bottom:30px;
}

.hero-main{
  background:#fff;
  border:1px solid var(--line);
  border-radius:22px;
  padding:30px;
  box-shadow:var(--shadow);
}

.hero-main h1{
  margin:0 0 10px;
  font-size:30px;
}

.hero-main p{
  color:var(--muted);
  line-height:1.6;
  max-width:650px;
}

.hero-buttons{
  display:flex;
  gap:10px;
  margin-top:22px;
  flex-wrap:wrap;
}

.primary{
  border:0;
  background:var(--accent);
  color:#fff;
  padding:12px 17px;
  border-radius:12px;
  font-weight:650;
}

.secondary{
  border:1px solid var(--line);
  background:#fff;
  padding:12px 17px;
  border-radius:12px;
  font-weight:600;
}

.progress-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:22px;
  padding:25px;
  box-shadow:var(--shadow);
}

.progress-card h3{
  margin-top:0;
}

.progress-number{
  font-size:40px;
  font-weight:800;
  margin:18px 0 10px;
}

.progress-bar{
  height:9px;
  border-radius:20px;
  background:#ededeb;
  overflow:hidden;
}

.progress-fill{
  height:100%;
  width:68%;
  background:var(--accent);
}

/* SECTIONS */

.section{
  margin-top:30px;
}

.section-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.section-header h2{
  margin:0;
  font-size:20px;
}

.section-header button{
  border:0;
  background:transparent;
  color:var(--accent);
  font-weight:600;
}

.notes-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.note-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:20px;
  transition:.2s;
}

.note-card:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow);
}

.note-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  background:var(--accent-soft);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:16px;
}

.note-card h3{
  margin:0 0 7px;
}

.note-card p{
  color:var(--muted);
  margin:0 0 15px;
  font-size:13px;
}

.note-progress{
  height:7px;
  background:#ededeb;
  border-radius:10px;
  overflow:hidden;
}

.note-progress div{
  height:100%;
  background:var(--accent);
}

.tools{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.tool{
  border:1px solid var(--line);
  background:#fff;
  border-radius:17px;
  padding:20px;
  text-align:left;
  transition:.2s;
}

.tool:hover{
  transform:translateY(-2px);
  box-shadow:var(--shadow);
}

.tool-icon{
  font-size:24px;
  margin-bottom:14px;
}

.tool strong{
  display:block;
  margin-bottom:6px;
}

.tool span{
  color:var(--muted);
  font-size:13px;
}

/* UPLOAD */

.upload-section{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.upload-box{
  background:#fff;
  border:1px dashed #cfcfc9;
  border-radius:20px;
  padding:30px;
  text-align:center;
}

.upload-box h3{
  margin-top:0;
}

.upload-box p{
  color:var(--muted);
  font-size:14px;
}

.upload-buttons{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-top:20px;
}

input[type="file"]{
  display:none;
}

.activity{
  background:#fff;
  border:1px solid var(--line);
  border-radius:20px;
  padding:25px;
}

.activity-item{
  padding:13px 0;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  gap:15px;
}

.activity-item:last-child{
  border-bottom:0;
}

.activity-item span{
  color:var(--muted);
  font-size:13px;
}

/* MOBILE */

.mobile-nav{
  display:none;
}

/* MODAL */

.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(20,20,20,.45);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:100;
}

.modal-overlay.show{
  display:flex;
}

.modal{
  width:min(620px,100%);
  max-height:90vh;
  overflow:auto;
  background:#fff;
  border-radius:24px;
  padding:25px;
  box-shadow:0 20px 70px rgba(0,0,0,.2);
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.modal-header h2{
  margin:0;
}

.close{
  border:0;
  background:#f1f1ee;
  width:36px;
  height:36px;
  border-radius:50%;
  font-size:20px;
}

.field{
  margin-bottom:16px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:650;
  margin-bottom:7px;
}

.field input,
.field textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:12px;
  padding:12px;
  outline:none;
}

.field textarea{
  min-height:110px;
  resize:vertical;
}

.camera-area{
  border:1px dashed #cfcfc9;
  background:#fafaf8;
  border-radius:16px;
  padding:20px;
  text-align:center;
  margin-bottom:18px;
}

.camera-buttons{
  display:flex;
  gap:9px;
  justify-content:center;
  flex-wrap:wrap;
}

.preview-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
  margin-top:15px;
}

.preview-item{
  position:relative;
  border-radius:14px;
  overflow:hidden;
  background:#eee;
  border:1px solid var(--line);
}

.preview-item img{
  width:100%;
  height:190px;
  object-fit:contain;
  display:block;
  background:#f5f5f3;
}

.remove-photo{
  position:absolute;
  right:8px;
  top:8px;
  border:0;
  background:rgba(0,0,0,.65);
  color:white;
  width:30px;
  height:30px;
  border-radius:50%;
}

.modal-actions{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-top:20px;
}

.toast{
  position:fixed;
  bottom:25px;
  left:50%;
  transform:translateX(-50%) translateY(20px);
  background:#20211f;
  color:white;
  padding:12px 17px;
  border-radius:12px;
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:200;
}

.toast.show{
  opacity:1;
  transform:translateX(-50%) translateY(0);
}

/* RESPONSIVE */

@media(max-width:900px){
  .sidebar{
    display:none;
  }

  .main{
    margin-left:0;
    padding:20px 16px 90px;
  }

  .hero{
    grid-template-columns:1fr;
  }

  .notes-grid{
    grid-template-columns:1fr;
  }

  .tools{
    grid-template-columns:repeat(2,1fr);
  }

  .upload-section{
    grid-template-columns:1fr;
  }

  .mobile-nav{
    position:fixed;
    display:flex;
    bottom:0;
    left:0;
    right:0;
    height:68px;
    background:#fff;
    border-top:1px solid var(--line);
    z-index:50;
    justify-content:space-around;
    align-items:center;
  }

  .mobile-nav button{
    border:0;
    background:transparent;
    color:var(--muted);
    font-size:11px;
  }

  .mobile-nav button.active{
    color:var(--accent);
  }
}

@media(max-width:520px){
  .hero-main{
    padding:22px;
  }

  .hero-main h1{
    font-size:25px;
  }

  .tools{
    grid-template-columns:1fr;
  }

  .preview-grid{
    grid-template-columns:1fr;
  }

  .topbar{
    display:block;
  }

  .search{
    width:100%;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="logo">
      <div class="logo-mark">S</div>
      StudySnap AI
    </div>

    <nav class="nav">
      <button class="active" onclick="selectNav(this)">⌂ Übersicht</button>
      <button onclick="selectNav(this)">▣ Meine Lernzettel</button>
      <button onclick="selectNav(this)">✓ Quiz</button>
      <button onclick="selectNav(this)">▤ Karteikarten</button>
      <button onclick="selectNav(this)">💬 StudySnap fragen</button>
      <button onclick="selectNav(this)">⚙ Einstellungen</button>
    </nav>

    <div class="profile">
      <div class="avatar">C</div>
      <div class="profile-text">
        <strong>Celine</strong>
        <span>Schülerkonto</span>
      </div>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main">

    <div class="topbar">
      <input
        class="search"
        id="searchInput"
        type="search"
        placeholder="🔎 Lernzettel suchen..."
        oninput="searchNotes()"
      >
    </div>

    <!-- HERO -->
    <section class="hero">

      <div class="hero-main">
        <h1>Schön, dass du da bist. 👋</h1>

        <p>
          Verwandle deine Lernzettel in Quizfragen, Karteikarten
          und verständliche Zusammenfassungen – alles an einem Ort.
        </p>

        <div class="hero-buttons">
          <button class="primary" onclick="openNoteModal()">
            ＋ Lernzettel hinzufügen
          </button>

          <button class="secondary" onclick="scrollToNotes()">
            Meine Lernzettel
          </button>
        </div>
      </div>

      <div class="progress-card">
        <h3>Dein Lernfortschritt</h3>

        <div class="progress-number">68%</div>

        <div class="progress-bar">
          <div class="progress-fill"></div>
        </div>

        <p style="color:var(--muted);font-size:13px;">
          Du bist gut unterwegs!
        </p>
      </div>

    </section>

    <!-- NOTES -->
    <section class="section" id="notesSection">

      <div class="section-header">
        <h2>Meine Lernzettel</h2>
        <button onclick="openNoteModal()">Alle anzeigen</button>
      </div>

      <div class="notes-grid" id="notesGrid">

        <div class="note-card searchable-note">
          <div class="note-icon">👁️</div>
          <h3>Biologie – Das Auge</h3>
          <p>12 Seiten · 82% gelernt</p>

          <div class="note-progress">
            <div style="width:82%;"></div>
          </div>
        </div>

        <div class="note-card searchable-note">
          <div class="note-icon">∑</div>
          <h3>Mathe – Terme</h3>
          <p>8 Seiten · 54% gelernt</p>

          <div class="note-progress">
            <div style="width:54%;"></div>
          </div>
        </div>

        <div class="note-card searchable-note">
          <div class="note-icon">A</div>
          <h3>Englisch – Grammar</h3>
          <p>6 Seiten · 31% gelernt</p>

          <div class="note-progress">
            <div style="width:31%;"></div>
          </div>
        </div>

      </div>
    </section>

    <!-- TOOLS -->
    <section class="section">

      <div class="section-header">
        <h2>Schnell lernen</h2>
      </div>

      <div class="tools">

        <button class="tool" onclick="openTool('Quiz')">
          <div class="tool-icon">🧠</div>
          <strong>Quiz erstellen</strong>
          <span>Teste dein Wissen.</span>
        </button>

        <button class="tool" onclick="openTool('Karteikarten')">
          <div class="tool-icon">🗂️</div>
          <strong>Karteikarten</strong>
          <span>Lerne wichtige Begriffe.</span>
        </button>

        <button class="tool" onclick="openTool('Zusammenfassung')">
          <div class="tool-icon">✨</div>
          <strong>Zusammenfassen</strong>
          <span>Das Wichtigste auf einen Blick.</span>
        </button>

        <button class="tool" onclick="openTool('StudySnap fragen')">
          <div class="tool-icon">💬</div>
          <strong>StudySnap fragen</strong>
          <span>Stelle Fragen zu deinem Stoff.</span>
        </button>

      </div>
    </section>

    <!-- UPLOAD -->
    <section class="section upload-section">

      <div class="upload-box">

        <h3>📚 Lernzettel hinzufügen</h3>

        <p>
          Ziehe deine Datei hierher oder wähle ein Foto bzw. eine Datei aus.
        </p>

        <div class="upload-buttons">

          <button class="primary" onclick="openNoteModal()">
            ＋ Hinzufügen
          </button>

          <button class="secondary" onclick="document.getElementById('mainFileInput').click()">
            Datei auswählen
          </button>

        </div>

        <input
          id="mainFileInput"
          type="file"
          accept="image/*,.pdf"
          multiple
          onchange="handleFile(event)"
        >

      </div>

      <div class="activity">

        <h3 style="margin-top:0;">Letzte Aktivitäten</h3>

        <div class="activity-item">
          <strong>Biologie gelernt</strong>
          <span>Heute</span>
        </div>

        <div class="activity-item">
          <strong>Quiz abgeschlossen</strong>
          <span>Gestern</span>
        </div>

        <div class="activity-item">
          <strong>Karteikarten wiederholt</strong>
          <span>Vor 2 Tagen</span>
        </div>

      </div>

    </section>

  </main>

  <!-- MOBILE NAV -->
  <nav class="mobile-nav">
    <button class="active" onclick="mobileNav(this)">⌂<br>Home</button>
    <button onclick="mobileNav(this)">▣<br>Lernzettel</button>
    <button onclick="mobileNav(this)">✓<br>Quiz</button>
    <button onclick="openNoteModal()">＋<br>Hinzufügen</button>
  </nav>

</div>


<!-- MODAL -->
<div class="modal-overlay" id="noteModal">

  <div class="modal">

    <div class="modal-header">
      <h2>Neuen Lernzettel erstellen</h2>

      <button class="close" onclick="closeNoteModal()">×</button>
    </div>

    <div class="field">
      <label>Titel</label>

      <input
        id="noteTitle"
        type="text"
        placeholder="z. B. Biologie – Das Auge"
      >
    </div>

    <div class="camera-area">

      <strong>📸 Lernzettel fotografieren</strong>

      <p>
        Du kannst eine oder mehrere Seiten fotografieren.
        Die Fotos werden anschließend hier angezeigt.
      </p>

      <div class="camera-buttons">

        <!-- KAMERA -->
        <button
          class="primary"
          onclick="openCamera()"
        >
          📷 Foto aufnehmen
        </button>

        <!-- GALERIE -->
        <button
          class="secondary"
          onclick="openGallery()"
        >
          🖼️ Fotogalerie
        </button>

        <!-- DATEI -->
        <button
          class="secondary"
          onclick="openFilePicker()"
        >
          📁 Datei auswählen
        </button>

      </div>

      <!-- VERSTECKTE DATEI-EINGABEN -->

      <input
        id="cameraInput"
        type="file"
        accept="image/*"
        capture="environment"
        multiple
        onchange="handleNoteImages(event)"
      >

      <input
        id="galleryInput"
        type="file"
        accept="image/*"
        multiple
        onchange="handleNoteImages(event)"
      >

      <input
        id="fileInput"
        type="file"
        accept="image/*,.pdf"
        multiple
        onchange="handleNoteImages(event)"
      >

      <!-- FOTO-VORSCHAU -->

      <div id="filePreview" class="preview-grid"></div>

    </div>

    <div class="field">

      <label>Notizen / Inhalt</label>

      <textarea
        id="noteContent"
        placeholder="Hier kannst du zusätzliche Informationen eingeben..."
      ></textarea>

    </div>

    <div class="modal-actions">

      <button
        class="secondary"
        onclick="closeNoteModal()"
      >
        Abbrechen
      </button>

      <button
        class="primary"
        onclick="saveNote()"
      >
        Lernzettel speichern
      </button>

    </div>

  </div>

</div>


<div class="toast" id="toast"></div>


<script>

/* -------------------------
   VARIABLES
------------------------- */

let selectedImages = [];


/* -------------------------
   TOAST
------------------------- */

function showToast(message){

  const toast = document.getElementById("toast");

  toast.textContent = message;

  toast.classList.add("show");

  setTimeout(function(){
    toast.classList.remove("show");
