          Neues Quiz
        </button>

      </div>
    `;

    renderDashboard();

    return;

  }

  const question =
    quizQuestions[quizIndex];

  area.innerHTML = `

    <div class="card">

      <p class="muted">
        Frage ${quizIndex+1}
        von ${quizQuestions.length}
      </p>

