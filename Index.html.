/* -------------------------
   FOTO / DATEI VERARBEITEN
------------------------- */

function handleNoteImages(event){

  const files = Array.from(event.target.files || []);

  if(!files.length){
    return;
  }

  files.forEach(function(file){

    if(file.type.startsWith("image/")){

      const reader = new FileReader();

      reader.onload = function(e){

        const imageData = e.target.result;

        selectedImages.push(imageData);

        displayImagePreview(
          imageData,
          selectedImages.length - 1
        );

      };

      reader.readAsDataURL(file);

    }else if(file.type === "application/pdf"){

      showToast("📄 PDF wurde ausgewählt.");

    }

  });

  showToast(
    files.length === 1
      ? "📸 Foto wurde hinzugefügt!"
      : `📸 ${files.length} Fotos wurden hinzugefügt!`
  );

  // Input zurücksetzen, damit dasselbe Foto erneut gewählt werden kann
  event.target.value = "";

}


/* -------------------------
   FOTO-VORSCHAU
------------------------- */

function displayImagePreview(imageData,index){

  const preview =
    document.getElementById("filePreview");

  const wrapper =
    document.createElement("div");

  wrapper.className = "preview-item";

  wrapper.dataset.index = index;

  const img =
    document.createElement("img");

  img.src = imageData;

  const removeButton =
    document.createElement("button");

  removeButton.className = "remove-photo";

  removeButton.textContent = "×";

  removeButton.onclick = function(){

    removeImage(index,wrapper);

  };

  wrapper.appendChild(img);

  wrapper.appendChild(removeButton);

  preview.appendChild(wrapper);

}


/* -------------------------
   FOTO LÖSCHEN
------------------------- */

function removeImage(index,wrapper){

  selectedImages[index] = null;

  wrapper.remove();

  showToast("Foto entfernt.");

}


/* -------------------------
   SPEICHERN
------------------------- */

function saveNote(){

  const title =
    document.getElementById("noteTitle")
      .value.trim();

  const content =
    document.getElementById("noteContent")
      .value.trim();

  if(!title){

    showToast("Bitte gib deinem Lernzettel einen Titel.");

    return;

  }

  const images =
    selectedImages.filter(Boolean);

  const note = {

    id:Date.now(),

    title:title,

    content:content,

    images:images,

    createdAt:new Date().toISOString()

  };


  let notes =
    JSON.parse(
      localStorage.getItem("studysnap_notes") || "[]"
    );

  notes.unshift(note);

  localStorage.setItem(
    "studysnap_notes",
    JSON.stringify(notes)
  );


  addNoteToScreen(note);


  document.getElementById("noteTitle").value = "";

  document.getElementById("noteContent").value = "";

  document.getElementById("filePreview").innerHTML = "";

  selectedImages = [];


  closeNoteModal();

  showToast("✅ Lernzettel wurde gespeichert!");

}


/* -------------------------
   LERNZETTEL AUF STARTSEITE
------------------------- */

function addNoteToScreen(note){

  const grid =
    document.getElementById("notesGrid");

  const card =
    document.createElement("div");

  card.className =
    "note-card searchable-note";


  let imageHTML = "📚";

  if(note.images && note.images.length){

    imageHTML =
      `<img src="${note.images[0]}"
      style="
        width:100%;
        height:100%;
        object-fit:cover;
        border-radius:12px;
      ">`;

  }


  card.innerHTML = `

    <div
      class="note-icon"
      style="overflow:hidden;"
    >
      ${imageHTML}
    </div>

    <h3>${escapeHTML(note.title)}</h3>

    <p>
      ${note.images ? note.images.length : 0} Foto(s)
    </p>

    <div class="note-progress">
      <div style="width:0%;"></div>
    </div>

  `;


  grid.prepend(card);

}


/* -------------------------
   GESPEICHERTE LERNZETTEL LADEN
------------------------- */

function loadSavedNotes(){

  const notes =
    JSON.parse(
      localStorage.getItem("studysnap_notes") || "[]"
    );

  notes.reverse().forEach(function(note){

    addNoteToScreen(note);

  });

}


/* -------------------------
   SUCHE
------------------------- */

function searchNotes(){

  const query =
    document.getElementById("searchInput")
      .value
      .toLowerCase()
      .trim();

  const notes =
    document.querySelectorAll(".searchable-note");

  notes.forEach(function(note){

    const text =
      note.textContent.toLowerCase();

    note.style.display =
      text.includes(query)
        ? ""
        : "none";

  });

}


