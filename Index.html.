<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudySnap AI – Smarter lernen</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #faf9ff;
      color: #171725;
    }

    html {
      scroll-behavior: smooth;
    }

    /* NAVIGATION */

    nav {
      height: 76px;
      max-width: 1160px;
      margin: auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
    }

    .logo span {
      color: #6c4cff;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      color: #686779;
      font-size: 14px;
    }

    .nav-links a {
      text-decoration: none;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      font-weight: 700;
    }

    .primary {
      background: #6c4cff;
      color: white;
      padding: 14px 19px;
      border-radius: 13px;
      box-shadow: 0 8px 24px rgba(108,76,255,.22);
    }

    .secondary {
      background: white;
      border: 1px solid #e5e2ef;
      padding: 14px 19px;
      border-radius: 13px;
      color: #171725;
    }

    /* HERO */

    .hero {
      max-width: 1160px;
      margin: 40px auto;
      padding: 30px 24px 80px;
      display: grid;
      grid-template-columns: 1fr .9fr;
      gap: 70px;
      align-items: center;
    }

    .badge {
      display: inline-block;
      background: #eeeaff;
      color: #5945d8;
      padding: 8px 13px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 800;
    }

    h1 {
      font-size: 62px;
      line-height: 1.02;
      letter-spacing: -3px;
      margin: 20px 0;
    }

    .hero-text {
      font-size: 18px;
      line-height: 1.6;
      color: #686779;
      max-width: 590px;
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-top: 26px;
    }

    .small-text {
      margin-top: 14px;
      font-size: 12px;
      color: #898797;
    }

    /* UPLOAD */

    .upload-box {
      background: white;
      border: 1px solid #e8e5f2;
      border-radius: 28px;
      padding: 16px;
      box-shadow: 0 25px 70px rgba(40,28,100,.10);
    }

    .drop-area {
      min-height: 350px;
      border: 2px dashed #d9d3f5;
      border-radius: 21px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 25px;
      background: #fbfaff;
    }

    .upload-icon {
      font-size: 30px;
      background: #eeeaff;
      padding: 18px;
      border-radius: 20px;
      margin-bottom: 15px;
    }

    .drop-area h2 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .drop-area p {
      color: #777587;
      font-size: 14px;
      margin-bottom: 20px;
    }

    #fileName {
      font-size: 12px;
      margin-top: 14px;
      color: #555268;
    }

    /* SECTIONS */

    section {
      max-width: 1160px;
      margin: auto;
      padding: 75px 24px;
    }

    .center {
      text-align: center;
    }

    .kicker {
      color: #6652dc;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    section h2 {
      font-size: 42px;
      letter-spacing: -1.7px;
      margin: 10px 0;
    }

    .subtitle {
      color: #6d6b7c;
      max-width: 590px;
      margin: auto;
      line-height: 1.6;
    }

    /* STEPS */

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 38px;
    }

    .card {
      background: white;
      border: 1px solid #e8e5f2;
      border-radius: 22px;
      padding: 27px;
      text-align: left;
    }

    .number {
      color: #908ca0;
      font-size: 12px;
      font-weight: 800;
    }

    .emoji {
      font-size: 28px;
      margin: 15px 0;
    }

    .card h3 {
      margin-bottom: 8px;
      font-size: 19px;
    }

    .card p {
      color: #6d6b7c;
      line-height: 1.55;
      font-size: 14px;
    }

    /* DEMO */

    .demo {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 38px;
    }

    .paper,
    .quiz {
      background: white;
      border: 1px solid #e8e5f2;
      border-radius: 24px;
      padding: 28px;
      text-align: left;
    }

    .paper-lines {
      color: #777587;
      line-height: 2;
      margin-top: 18px;
      font-size: 14px;
    }

    .question {
      font-weight: 750;
      margin: 20px 0;
    }

    .option {
      border: 1px solid #e8e5f2;
      border-radius: 12px;
      padding: 11px;
      margin: 8px 0;
      font-size: 14px;
      cursor: pointer;
    }

    .option:hover {
      background: #f4f1ff;
      border-color: #6c4cff;
    }

    /* FEATURES */

    .features {
      grid-template-columns: repeat(4, 1fr);
    }

    /* CTA */

    .cta {
      max-width: 1100px;
      margin: 30px auto 75px;
      background: #171725;
      color: white;
      border-radius: 30px;
      padding: 58px 24px;
      text-align: center;
    }

    .cta h2 {
      font-size: 42px;
      margin: 10px 0;
    }

    .cta p {
      color: #c8c6d3;
      margin-bottom: 25px;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid #e8e5f2;
      padding: 28px 24px;
      color: #777587;
      font-size: 13px;
    }

    .footer-content {
      max-width: 1160px;
      margin: auto;
      display: flex;
      justify-content: space-between;
    }

    /* MESSAGE */

    .message {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 30px);
      opacity: 0;
      background: #171725;
      color: white;
      padding: 13px 18px;
      border-radius: 14px;
      font-size: 13px;
      transition: .3s;
    }

    .message.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    /* MOBILE */

    @media(max-width:850px) {

      .nav-links {
        display: none;
      }

      .hero {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      h1 {
        font-size: 48px;
      }

      .cards,
      .features,
      .demo {
        grid-template-columns: 1fr;
      }

      section h2,
      .cta h2 {
        font-size: 34px;
      }

      .footer-content {
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</head>

