function subjectIcon(subject){

  const icons={

    "Biologie":"🧬",
    "Mathe":"🧮",
    "Englisch":"🇬🇧",
    "Deutsch":"📖",
    "Geschichte":"🏛️",
    "Physik":"⚡",
    "Chemie":"🧪",
    "Sonstiges":"📚"

  };

  return icons[subject] || "📚";

}

function formatDate(date){

  return new Date(
    date+"T00:00:00"
  ).toLocaleDateString(
    "de-DE",
    {
      day:"2-digit",
      month:"2-digit",
      year:"numeric"
    }
  );

}

function safe(text){

  return String(text || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


