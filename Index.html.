<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudySnap AI</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--bg:#f6f7fb;
--card:#fff;
--text:#171923;
--muted:#777b87;
--border:#e8e9ef;
--primary:#6257d8;
--light:#eeecff;
--green:#35a86b;
--red:#e95d67;
--shadow:0 8px 30px rgba(30,30,60,.06)
}

body{
font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
background:var(--bg);
color:var(--text)
}

button,input,textarea,select{font:inherit}

button{cursor:pointer;border:0}

.app{display:flex;min-height:100vh}

.sidebar{
width:230px;
background:#fff;
border-right:1px solid var(--border);
padding:24px 16px;
position:fixed;
height:100vh
}

.logo{
font-size:22px;
font-weight:800;
margin-bottom:28px
}

.logo span{color:var(--primary)}

.nav button{
display:block;
width:100%;
padding:12px;
margin:4px 0;
background:none;
border-radius:10px;
text-align:left;
color:#555
}

.nav button:hover,.nav button.active{
background:var(--light);
color:var(--primary);
font-weight:600
}

.main{
margin-left:230px;
width:calc(100% - 230px);
padding:28px;
max-width:1400px
}

.top{
display:flex;
justify-content:space-between;
align-items:center;
gap:15px;
margin-bottom:25px
}

.search{
background:#fff;
border:1px solid var(--border);
border-radius:12px;
padding:12px 15px;
width:320px;
outline:none
}

.page{display:none}
.page.active{display:block}

.hero{
background:linear-gradient(135deg,#eeeaff,#fff);
border:1px solid #e5e1ff;
border-radius:20px;
padding:30px;
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
margin-bottom:22px
}

.hero h1{font-size:28px;margin-bottom:8px}
.hero p{color:var(--muted);max-width:600px;line-height:1.5}

.primary,.secondary,.danger{
padding:11px 15px;
border-radius:10px;
font-weight:600
}

.primary{background:var(--primary);color:white}
.secondary{background:#fff;border:1px solid var(--border)}
.danger{background:#fff0f1;color:var(--red)}

.buttons{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:14px;
margin-bottom:22px
}

.card{
background:var(--card);
border:1px solid var(--border);
border-radius:16px;
padding:18px;
box-shadow:var(--shadow)
}

.stat-number{font-size:25px;font-weight:800;margin-top:5px}
.muted{color:var(--muted);font-size:13px}

.section-title{
display:flex;
justify-content:space-between;
align-items:center;
margin:25px 0 13px
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px
}

.note h3{margin:10px 0 5px}
.icon{font-size:28px}

.progress{
height:7px;
background:#eee;
border-radius:10px;
overflow:hidden;
margin:13px 0
}

.progress div{
height:100%;
background:var(--primary);
width:0
}

.tool{
cursor:pointer;
transition:.2s
}

.tool:hover{transform:translateY(-2px)}

.form{
display:grid;
gap:12px;
max-width:600px
}

input,textarea,select{
width:100%;
padding:12px;
border:1px solid var(--border);
border-radius:10px;
background:#fff;
outline:none
}

textarea{min-height:130px;resize:vertical}

.list{
display:grid;
gap:10px;
margin-top:15px
}

.row{
background:#fff;
border:1px solid var(--border);
border-radius:12px;
padding:14px;
display:flex;
align-items:center;
justify-content:space-between;
gap:10px
}

.flash{
max-width:500px;
height:250px;
perspective:1000px;
margin:20px auto
}

.flash-inner{
width:100%;
height:100%;
position:relative;
transition:.5s;
transform-style:preserve-3d
}

.flash.flipped .flash-inner{transform:rotateY(180deg)}

.face{
position:absolute;
width:100%;
height:100%;
backface-visibility:hidden;
background:#fff;
border:1px solid var(--border);
border-radius:20px;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
padding:20px;
box-shadow:var(--shadow)
}

.back{transform:rotateY(180deg)}

.face strong{
font-size:25px;
margin-top:12px
}

.empty{
text-align:center;
color:var(--muted);
padding:30px
}

.modal{
display:none;
position:fixed;
inset:0;
background:rgba(0,0,0,.35);
align-items:center;
justify-content:center;
padding:20px;
z-index:10
}

.modal.show{display:flex}

.modal-box{
background:#fff;
border-radius:18px;
padding:22px;
width:min(600px,100%);
max-height:90vh;
overflow:auto
}

.preview{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:10px
}

.preview img{
width:90px;
height:90px;
object-fit:cover;
border-radius:10px
}

.toast{
position:fixed;
bottom:25px;
left:50%;
transform:translateX(-50%);
background:#171923;
color:#fff;
padding:12px 18px;
border-radius:10px;
display:none;
z-index:20
}

.toast.show{display:block}

.mobile{
display:none
}

@media(max-width:800px){
.sidebar{display:none}
.main{margin:0;width:100%;padding:18px;padding-bottom:80px}
.stats{grid-template-columns:repeat(2,1fr)}
.grid{grid-template-columns:1fr}
.hero{display:block}
.search{width:100%}
.top{display:block}
.mobile{
display:flex;
position:fixed;
bottom:0;
left:0;
right:0;
background:#fff;
border-top:1px solid var(--border);
justify-content:space-around;
padding:8px;
z-index:5
}
.mobile button{
background:none;
font-size:11px;
color:#555
}
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar">
<div class="logo">Study<span>Snap</span> AI</div>

<nav class="nav">
<button class="active" onclick="show('dashboard',this)">🏠 Übersicht</button>
<button onclick="show('notes',this)">📚 Lernzettel</button>
<button onclick="show('quiz',this)">🧠 Quiz</button>
<button onclick="show('cards',this)">🃏 Karteikarten</button>
<button onclick="show('vocab',this)">🇬🇧 Vokabeln</button>
<button onclick="show('questions',this)">💬 StudySnap fragen</button>
<button onclick="show('exams',this)">📅 Klassenarbeiten</button>
<button onclick="show('tasks',this)">✅ Aufgaben</button>
<button onclick="show('timer',this)">⏱️ Lern-Timer</button>
</nav>
</aside>

<main class="main">

<div class="top">
<h2>StudySnap AI</h2>
<input class="search" id="search" placeholder="🔎 Lernzettel suchen..." oninput="searchNotes()">
</div>


<!-- DASHBOARD -->

<section id="dashboard" class="page active">

<div class="hero">
<div>
<h1>Schön, dass du da bist. 👋</h1>
<p>
Verwandle deine Lernzettel in Quizfragen,
Karteikarten und verständliche Lerninhalte –
alles an einem Ort.
</p>

<div class="buttons">
<button class="primary" onclick="openModal()">＋ Lernzettel hinzufügen</button>
<button class="secondary" onclick="show('notes')">Meine Lernzettel</button>
</div>
</div>

<div class="card">
<div class="muted">Gesamtfortschritt</div>
<div class="stat-number" id="progress">0%</div>
</div>
</div>

<div class="stats">
<div class="card">
<div class="muted">📚 Lernzettel</div>
<div class="stat-number" id="statNotes">0</div>
</div>

<div class="card">
<div class="muted">🧠 Quizze</div>
<div class="stat-number" id="statQuiz">0</div>
</div>

<div class="card">
<div class="muted">🔥 Lernserie</div>
<div class="stat-number">1 Tag</div>
</div>

<div class="card">
<div class="muted">⭐ XP</div>
<div class="stat-number" id="statXP">0</div>
</div>
</div>

<div class="section-title"><h2>Meine Lernzettel</h2></div>
<div id="dashboardNotes" class="grid"></div>

<div class="section-title"><h2>Schnell lernen</h2></div>

<div class="grid">
<div class="card tool" onclick="show('quiz')">
<div class="icon">🧠</div>
<h3>Quiz starten</h3>
<p class="muted">Teste dein Wissen.</p>
</div>

<div class="card tool" onclick="show('cards')">
<div class="icon">🃏</div>
<h3>Karteikarten</h3>
<p class="muted">Lerne aktiv.</p>
</div>

<div class="card tool" onclick="show('timer')">
<div class="icon">⏱️</div>
<h3>Lern-Timer</h3>
<p class="muted">Fokussiert lernen.</p>
</div>
</div>

</section>


<!-- NOTES -->

<section id="notes" class="page">
<h1>📚 Meine Lernzettel</h1>
<p class="muted">Hier findest du deine gespeicherten Lernzettel.</p>
<div id="notesList" class="grid" style="margin-top:20px"></div>
</section>


<!-- QUIZ -->

<section id="quiz" class="page">
<h1>🧠 Quiz</h1>
<p class="muted">Teste dein Wissen.</p>

<div class="card" style="margin-top:20px;max-width:600px">
<div class="form">
<input id="quizTopic" placeholder="Thema, z. B. Fotosynthese">
<button class="primary" onclick="startQuiz()">Quiz starten</button>
</div>
</div>

<div id="quizArea" style="margin-top:20px"></div>
</section>


<!-- CARDS -->

<section id="cards" class="page">
<h1>🃏 Karteikarten</h1>
<p class="muted">Übe mit StudySnap-Karteikarten.</p>

<div class="flash" id="flash" onclick="flipCard()">
<div class="flash-inner">
<div class="face">
<span>Frage</span>
<strong id="flashQ">Was ist Lernen?</strong>
</div>
<div class="face back">
<span>Antwort</span>
<strong id="flashA">Wissen und Fähigkeiten werden aufgebaut und gefestigt.</strong>
</div>
</div>
</div>

<div style="text-align:center">
<button class="secondary" onclick="nextCard()">Nächste Karte →</button>
</div>
</section>


<!-- VOCAB -->

<section id="vocab" class="page">
<h1>🇬🇧 Vokabeln</h1>
<p class="muted">Erstelle deine eigenen Vokabelkarten.</p>

<div class="card" style="margin-top:20px">
<div class="form">
<input id="word" placeholder="Englisch, z. B. beautiful">
<input id="translation" placeholder="Deutsch, z. B. schön">
<button class="primary" onclick="addVocab()">Vokabel hinzufügen</button>
</div>
</div>

<div id="vocabList" class="list"></div>
</section>


<!-- QUESTIONS -->

<section id="questions" class="page">
<h1>💬 StudySnap fragen</h1>
<p class="muted">Stelle eine Frage zu deinem Lernstoff.</p>

<div class="card" style="margin-top:20px">
<div class="form">
<textarea id="question" placeholder="Was möchtest du wissen?"></textarea>
<button class="primary" onclick="ask()">Frage stellen</button>
</div>

<div id="answer" style="margin-top:15px"></div>
</div>
</section>


<!-- EXAMS -->

<section id="exams" class="page">
<h1>📅 Klassenarbeiten</h1>
<p class="muted">Behalte deine nächsten Tests im Blick.</p>

<div class="card" style="margin-top:20px">
<div class="form">
<input id="examSubject" placeholder="Fach, z. B. Mathe">
<input id="examTopic" placeholder="Thema">
<input id="examDate" type="date">
<button class="primary" onclick="addExam()">Klassenarbeit hinzufügen</button>
</div>
</div>

<div id="examList" class="grid" style="margin-top:20px"></div>
</section>


<!-- TASKS -->

<section id="tasks" class="page">
<h1>✅ Aufgaben</h1>
<p class="muted">Behalte deine Aufgaben im Überblick.</p>

<div class="card" style="margin-top:20px">
<div class="form">
<input id="task" placeholder="Neue Aufgabe...">
<button class="primary" onclick="addTask()">Aufgabe hinzufügen</button>
</div>
</div>

<div id="taskList" class="list"></div>
</section>


<!-- TIMER -->

<section id="timer" class="page">
<h1>⏱️ Lern-Timer</h1>
<p class="muted">25 Minuten konzentriert lernen.</p>

<div class="card" style="max-width:500px;text-align:center;margin-top:20px">
<div style="font-size:55px;font-weight:800" id="timerDisplay">25:00</div>

<div class="buttons" style="justify-content:center">
<button class="primary" onclick="toggleTimer()" id="timerBtn">▶ Start</button>
<button class="secondary" onclick="resetTimer()">↻ Reset</button>
</div>
</div>
</section>

</main>
</div>


<!-- MOBILE -->

<div class="mobile">
<button onclick="show('dashboard')">🏠<br>Home</button>
<button onclick="show('notes')">📚<br>Lernzettel</button>
<button onclick="show('quiz')">🧠<br>Quiz</button>
<button onclick="show('vocab')">🇬🇧<br>Vokabeln</button>
<button onclick="show('exams')">📅<br>Tests</button>
</div>


<!-- UPLOAD MODAL -->

<div class="modal" id="modal">
<div class="modal-box">

<div style="display:flex;justify-content:space-between;align-items:center">
<h2>📚 Lernzettel hinzufügen</h2>
<button class="danger" onclick="closeModal()">✕</button>
</div>

<div class="form" style="margin-top:20px">

<input id="noteTitle" placeholder="Titel, z. B. Fotosynthese">

<select id="noteSubject">
<option>Biologie</option>
<option>Mathe</option>
<option>Englisch</option>
<option>Deutsch</option>
<option>Geschichte</option>
<option>Physik</option>
<option>Chemie</option>
<option>Sonstiges</option>
</select>

<textarea id="noteContent" placeholder="Lernstoff hier eingeben..."></textarea>

<input type="file" id="noteImage" accept="image/*,.pdf" multiple onchange="previewFiles()">

<div id="previews" class="preview"></div>

<button class="primary" onclick="saveNote()">Lernzettel speichern</button>

</div>
</div>
</div>


<div class="toast" id="toast"></div>


<script>

let notes=JSON.parse(localStorage.getItem("notes")||"[]");
let vocab=JSON.parse(localStorage.getItem("vocab")||"[]");
let exams=JSON.parse(localStorage.getItem("exams")||"[]");
let tasks=JSON.parse(localStorage.getItem("tasks")||"[]");
let quizCount=Number(localStorage.getItem("quizCount")||0);
let xp=Number(localStorage.getItem("xp")||0);

function save(){
localStorage.setItem("notes",JSON.stringify(notes));
localStorage.setItem("vocab",JSON.stringify(vocab));
localStorage.setItem("exams",JSON.stringify(exams));
localStorage.setItem("tasks",JSON.stringify(tasks));
localStorage.setItem("quizCount",quizCount);
localStorage.setItem("xp",xp);
}

function show(id,button){

document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));

document.getElementById(id).classList.add("active");

document.querySelectorAll(".nav button").forEach(b=>b.classList.remove("active"));

if(button)button.classList.add("active");

if(id==="dashboard")renderDashboard();
if(id==="notes")renderNotes();
if(id==="vocab")renderVocab();
if(id==="exams")renderExams();
if(id==="tasks")renderTasks();

window.scrollTo(0,0);
}

function toast(text){

let t=document.getElementById("toast");
t.textContent=text;
t.classList.add("show");

setTimeout(()=>t.classList.remove("show"),2200);
}

function openModal(){
document.getElementById("modal").classList.add("show");
}

function closeModal(){
document.getElementById("modal").classList.remove("show");
}

function previewFiles(){

let box=document.getElementById("previews");
box.innerHTML="";

[...document.getElementById("noteImage").files].forEach(file=>{

if(file.type.startsWith("image/")){

let img=document.createElement("img");
img.src=URL.createObjectURL(file);
box.appendChild(img);

}

});

}

function saveNote(){

let title=document.getElementById("noteTitle").value.trim();
let subject=document.getElementById("noteSubject").value;
let content=document.getElementById("noteContent").value.trim();
let files=document.getElementById("noteImage").files;

if(!title){
toast("Bitte einen Titel eingeben.");
return;
}

let note={
id:Date.now(),
title,
subject,
content,
files:files.length,
progress:0
};

notes.unshift(note);
save();

document.getElementById("noteTitle").value="";
document.getElementById("noteContent").value="";
document.getElementById("noteImage").value="";
document.getElementById("previews").innerHTML="";

closeModal();

renderDashboard();
renderNotes();

toast("Lernzettel gespeichert ✓");
}

function renderDashboard(){

document.getElementById("statNotes").textContent=notes.length;
document.getElementById("statQuiz").textContent=quizCount;
document.getElementById("statXP").textContent=xp;

let box=document.getElementById("dashboardNotes");

if(!notes.length){

box.innerHTML='<div class="card empty">✨ Dein erster Lernzettel wartet hier.</div>';
return;
}

box.innerHTML=notes.slice(0,3).map(note=>noteHTML(note)).join("");

}

function renderNotes(){

let box=document.getElementById("notesList");

if(!notes.length){

box.innerHTML='<div class="card empty">Noch keine Lernzettel vorhanden.</div>';
return;
}

box.innerHTML=notes.map(note=>noteHTML(note,true)).join("");

}

function noteHTML(note,deleteButton=false){

return `
<div class="card note">
<div class="icon">📚</div>
<h3>${safe(note.title)}</h3>
<p class="muted">${safe(note.subject)}</p>
${note.content?`<p style="margin-top:10px;line-height:1.5">${safe(note.content)}</p>`:""}
<div class="progress"><div style="width:${note.progress}%"></div></div>
<p class="muted">${note.progress}% gelernt · ${note.files} Datei(en)</p>
${deleteButton?`<button class="danger" style="margin-top:12px" onclick="deleteNote(${note.id})">Löschen</button>`:""}
</div>`;
}

function deleteNote(id){

notes=notes.filter(n=>n.id!==id);
save();
renderNotes();
renderDashboard();
toast("Lernzettel gelöscht");
}

function searchNotes(){

let q=document.getElementById("search").value.toLowerCase();

let box=document.getElementById("dashboardNotes");

let result=notes.filter(n=>
n.title.toLowerCase().includes(q)||
n.subject.toLowerCase().includes(q)||
n.content.toLowerCase().includes(q)
);

box.innerHTML=result.length
?result.map(n=>noteHTML(n)).join("")
:'<div class="card empty">🔎 Nichts gefunden.</div>';
}


/* QUIZ */

let questions=[
["Was hilft beim Lernen am meisten?","Aktives Wiederholen und Üben."],
["Was ist eine Zusammenfassung?","Eine kurze Darstellung der wichtigsten Informationen."],
["Was sind Karteikarten?","Karten mit Frage und Antwort zum Wiederholen."]
];

let qIndex=0;

function startQuiz(){

qIndex=0;
renderQuestion();
}

function renderQuestion(){

let q=questions[qIndex];

document.getElementById("quizArea").innerHTML=`
<div class="card" style="max-width:600px">
<p class="muted">Frage ${qIndex+1} von ${questions.length}</p>
<h2 style="margin:12px 0">${q[0]}</h2>
<button class="primary" onclick="showAnswer()">Antwort anzeigen</button>
<div id="quizAnswer"></div>
</div>`;
}

function showAnswer(){

let box=document.getElementById("quizAnswer");

box.innerHTML=`
<p style="margin-top:15px;background:#f4f2ff;padding:15px;border-radius:10px">
<strong>Antwort:</strong><br>${questions[qIndex][1]}
</p>
<button class="secondary" style="margin-top:10px" onclick="nextQuestion()">Weiter →</button>`;
}

function nextQuestion(){

qIndex++;

if(qIndex>=questions.length){

quizCount++;
xp+=20;
save();

document.getElementById("quizArea").innerHTML=`
<div class="card empty">
🏆 Quiz geschafft!<br>
Du hast ${questions.length} Fragen gelernt.
</div>`;

renderDashboard();
return;
}

renderQuestion();
}


/* FLASHCARDS */

let cards=[
["Was ist Lernen?","Wissen und Fähigkeiten aufbauen."],
["Was hilft beim Lernen?","Wiederholen, Üben und aktives Abrufen."],
["Was ist ein Quiz?","Eine Reihe von Fragen zum Testen des Wissens."]
];

let cardIndex=0;

function flipCard(){
document.getElementById("flash").classList.toggle("flipped");
}

function nextCard(){

cardIndex=(cardIndex+1)%cards.length;

document.getElementById("flashQ").textContent=cards[cardIndex][0];
document.getElementById("flashA").textContent=cards[cardIndex][1];

document.getElementById("flash").classList.remove("flipped");
}


/* VOCABULARY */

function addVocab(){

let word=document.getElementById("word").value.trim();
let translation=document.getElementById("translation").value.trim();

if(!word||!translation){
toast("Bitte beide Felder ausfüllen.");
return;
}

vocab.push({id:Date.now(),word,translation});

xp+=5;
save();

document.getElementById("word").value="";
document.getElementById("translation").value="";

renderVocab();
toast("Vokabel hinzugefügt ✓");
}

function renderVocab(){

let box=document.getElementById("vocabList");

if(!vocab.length){
box.innerHTML='<div class="card empty">Noch keine Vokabeln.</div>';
return;
}

box.innerHTML=vocab.map(v=>`
<div class="row">
<div><strong>${safe(v.word)}</strong><br><span class="muted">${safe(v.translation)}</span></div>
<button class="danger" onclick="deleteVocab(${v.id})">Löschen</button>
</div>`).join("");
}

function deleteVocab(id){

vocab=vocab.filter(v=>v.id!==id);
save();
renderVocab();
}


/* QUESTIONS */

function ask(){

let q=document.getElementById("question").value.trim();

if(!q){
toast("Schreibe zuerst eine Frage.");
return;
}

document.getElementById("answer").innerHTML=`
<div class="card">
<strong>🤖 StudySnap</strong>
<p class="muted" style="margin-top:8px">
Deine Frage ist angekommen. Die echte KI wird später deinen Lernstoff analysieren und dir darauf basierend antworten.
</p>
</div>`;

xp+=2;
save();
}


/* EXAMS */

function addExam(){

let subject=document.getElementById("examSubject").value.trim();
let topic=document.getElementById("examTopic").value.trim();
let date=document.getElementById("examDate").value;

if(!subject||!date){
toast("Fach und Datum eingeben.");
return;
}

exams.push({id:Date.now(),subject,topic,date});
save();

document.getElementById("examSubject").value="";
document.getElementById("examTopic").value="";
document.getElementById("examDate").value="";

renderExams();
toast("Klassenarbeit gespeichert ✓");
}

function countdown(date){

let diff=new Date(date+"T00:00:00")-new Date();

if(diff<=0)return"Heute";

let days=Math.ceil(diff/86400000);

return days===1?"Morgen":"Noch "+days+" Tage";
}

function renderExams(){

let box=document.getElementById("examList");

if(!exams.length){
box.innerHTML='<div class="card empty">Keine Klassenarbeiten eingetragen.</div>';
return;
}

box.innerHTML=exams.map(e=>`
<div class="card">
<div class="muted">${new Date(e.date).toLocaleDateString("de-DE")}</div>
<h3 style="margin:8px 0">${safe(e.subject)}</h3>
<p class="muted">${safe(e.topic)}</p>
<div style="font-size:20px;font-weight:800;margin:15px 0;color:var(--primary)">
${countdown(e.date)}
</div>
<button class="danger" onclick="deleteExam(${e.id})">Löschen</button>
</div>`).join("");
}

function deleteExam(id){

exams=exams.filter(e=>e.id!==id);
save();
renderExams();
}


/* TASKS */

function addTask(){

let text=document.getElementById("task").value.trim();

if(!text){
toast("Aufgabe eingeben.");
return;
}

tasks.push({id:Date.now(),text,done:false});
save();

document.getElementById("task").value="";
renderTasks();
}

function renderTasks(){

let box=document.getElementById("taskList");

if(!tasks.length){
box.innerHTML='<div class="card empty">Keine Aufgaben.</div>';
return;
}

box.innerHTML=tasks.map(t=>`
<div class="row">
<label>
<input type="checkbox" ${t.done?"checked":""} onchange="toggleTask(${t.id})">
${safe(t.text)}
</label>
<button class="danger" onclick="deleteTask(${t.id})">✕</button>
</div>`).join("");
}

function toggleTask(id){

let task=tasks.find(t=>t.id===id);

if(task)task.done=!task.done;

save();
renderTasks();
}

function deleteTask(id){

tasks=tasks.filter(t=>t.id!==id);
save();
renderTasks();
}


/* TIMER */

let seconds=1500;
let timer=null;

function updateTimer(){

let m=Math.floor(seconds/60);
let s=seconds%60;

document.getElementById("timerDisplay").textContent=
String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
}

function toggleTimer(){

if(timer){

clearInterval(timer);
timer=null;
document.getElementById("timerBtn").textContent="▶ Start";
return;
}

document.getElementById("timerBtn").textContent="⏸ Pause";

timer=setInterval(()=>{

seconds--;
updateTimer();

if(seconds<=0){

clearInterval(timer);
timer=null;
seconds=1500;

xp+=25;
save();

document.getElementById("timerBtn").textContent="▶ Start";

toast("Lernzeit geschafft! 🎉");
updateTimer();
}

},1000);
}

function resetTimer(){

clearInterval(timer);
timer=null;
seconds=1500;
document.getElementById("timerBtn").textContent="▶ Start";
updateTimer();
}


/* SECURITY */

function safe(text){

return String(text||"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");
}


/* START */

renderDashboard();
renderNotes();
renderVocab();
renderExams();
renderTasks();
updateTimer();

</script>

