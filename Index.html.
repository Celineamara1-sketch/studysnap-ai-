          onclick="deleteExam(${exam.id})"
        >
          Löschen
        </button>

      </div>

    `).join("");

}

function deleteExam(id){

  exams =
    exams.filter(
      exam=>exam.id !== id
    );

  saveData();

  renderExams();

}


/* ================================
   AUFGABEN
================================ */

function addTask(){

  const input =
    document.getElementById("taskInput");

  const text =
    input.value.trim();

  if(!text){

    showToast("Schreibe zuerst eine Aufgabe.");

    return;

  }

  tasks.push({

    id:Date.now(),

    text:text,

    done:false

  });

  saveData();

  input.value="";

  renderTasks();

}

function renderTasks(){

  const list =
    document.getElementById("taskList");

  if(!tasks.length){

    list.innerHTML = `
      <div class="card empty">
        ✓ Keine Aufgaben.
      </div>
    `;

    return;

  }

  list.innerHTML =
    tasks.map(task=>`

      <div class="row">

        <label
          style="
            display:flex;
            align-items:center;
            gap:10px;
            flex:1;
          "
        >

          <input
            type="checkbox"
            ${task.done ? "checked" : ""}
            onchange="toggleTask(${task.id})"
            style="width:auto"
          >

          <span class="${task.done ? "done" : ""}">
            ${safe(task.text)}
          </span>

        </label>

        <button
          class="danger-btn"
          onclick="deleteTask(${task.id})"
        >
          ✕
        </button>

      </div>

    `).join("");

}

function toggleTask(id){

  const task =
    tasks.find(t=>t.id === id);

  if(task){
    task.done = !task.done;
  }

  saveData();

  renderTasks();

}

function deleteTask(id){

  tasks =
    tasks.filter(
      task=>task.id !== id
    );

  saveData();

  renderTasks();

}


/* ================================
   TIMER
================================ */

function updateTimer(){

  const minutes =
    Math.floor(timerSeconds/60);

  const seconds =
    timerSeconds%60;

  document.getElementById("timerDisplay")
    .textContent =
      String(minutes).padStart(2,"0")
      + ":" +
      String(seconds).padStart(2,"0");

}

function toggleTimer(){

  if(timerInterval){

    clearInterval(timerInterval);

    timerInterval=null;

    document.getElementById("timerButton")
      .textContent="▶ Start";

    return;

  }

  document.getElementById("timerButton")
    .textContent="⏸ Pause";

  timerInterval =
    setInterval(()=>{

      timerSeconds--;

      updateTimer();

      if(timerSeconds <= 0){

        clearInterval(timerInterval);

        timerInterval=null;

        timerSeconds=25*60;

        stats.xp += 25;

        saveData();

        document.getElementById("timerButton")
          .textContent="▶ Start";

        updateTimer();

        showToast(
          "Lernzeit geschafft! 🎉"
        );

      }

    },1000);

}

function resetTimer(){

  clearInterval(timerInterval);

  timerInterval=null;

  timerSeconds=25*60;

  document.getElementById("timerButton")
    .textContent="▶ Start";

  updateTimer();

}


