<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudySnap AI</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f6f7fb;
  --card:#ffffff;
  --text:#171923;
  --muted:#777b87;
  --border:#e8e9ef;
  --primary:#6257e8;
  --primary-light:#eeecff;
  --green:#35a86b;
  --orange:#ef9b45;
  --red:#e95d67;
  --shadow:0 8px 30px rgba(30,30,60,.06);
}

body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input,textarea,select{
  font:inherit;
}

button{
  cursor:pointer;
  border:none;
}

.app{
  display:flex;
  min-height:100vh;
}

/* SIDEBAR */
.sidebar{
  width:245px;
  background:#fff;
  border-right:1px solid var(--border);
  padding:25px 16px;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  z-index:20;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 10px 30px;
  font-size:20px;
  font-weight:800;
}

.logo-icon{
  width:36px;
  height:36px;
  border-radius:11px;
  background:var(--primary);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

.logo span{
  color:var(--primary);
}

.nav-title{
  color:#aaaeba;
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.08em;
  padding:0 12px 10px;
}

.nav{
  display:flex;
  flex-direction:column;
  gap:5px;
}

.nav button{
  width:100%;
  text-align:left;
  padding:12px;
  border-radius:11px;
  background:transparent;
  color:#696d78;
  font-size:14px;
  display:flex;
  align-items:center;
  gap:11px;
}

.nav button:hover,
.nav button.active{
  background:var(--primary-light);
  color:var(--primary);
  font-weight:600;
}

.nav-icon{
  width:21px;
  text-align:center;
}

profile{
  position:absolute;
  left:16px;
  right:16px;
  bottom:20px;
  border-top:1px solid var(--border);
  padding:16px 8px 0;
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:36px;
  height:36px;
  background:#eceaff;
  color:var(--primary);
  border-radius:50%;
  display:flex;
  justify-content:center;
  align-items:center;
  font-weight:700;
}

.profile-name{
  font-size:13px;
  font-weight:700;
}

.profile-small{
  color:var(--muted);
  font-size:11px;
  margin-top:2px;
}

/* MAIN */
.main{
  margin-left:245px;
  width:calc(100% - 245px);
  min-height:100vh;
}

.topbar{
  height:74px;
  background:#fff;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 35px;
  position:sticky;
  top:0;
  z-index:10;
}

.search{
  width:350px;
  background:#f7f7fa;
  border:1px solid var(--border);
  border-radius:11px;
  display:flex;
  align-items:center;
  padding:9px 13px;
  gap:8px;
}

.search input{
  width:100%;
  border:none;
  outline:none;
  background:transparent;
  font-size:13px;
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.icon-btn{
  width:38px;
  height:38px;
  border-radius:10px;
  background:#f7f7fa;
  color:#626572;
}

.content{
  padding:30px 35px 100px;
  max-width:1450px;
  margin:auto;
}

/* BUTTONS */
.primary-btn{
  background:var(--primary);
  color:white;
  padding:11px 17px;
  border-radius:10px;
  font-weight:650;
  font-size:13px;
  box-shadow:0 5px 14px rgba(98,87,232,.18);
}

.primary-btn:hover{
  opacity:.92;
}

.secondary-btn{
  background:#fff;
  color:#525560;
  border:1px solid var(--border);
  padding:10px 15px;
  border-radius:10px;
  font-weight:600;
  font-size:13px;
}

.danger-btn{
  background:#fff0f1;
  color:#d94e59;
  padding:9px 12px;
  border-radius:9px;
  font-size:12px;
  font-weight:600;
}

/* HERO */
.hero{
  background:linear-gradient(135deg,#6257e8,#756cf0);
  border-radius:20px;
  padding:30px;
  color:white;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:25px;
  box-shadow:var(--shadow);
}

.hero h1{
  font-size:28px;
  margin-bottom:9px;
}

.hero p{
  max-width:650px;
  color:#e9e7ff;
  line-height:1.55;
  font-size:14px;
}

.hero-buttons{
  margin-top:20px;
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.hero .primary-btn{
  background:white;
  color:var(--primary);
}

.hero .secondary-btn{
  background:rgba(255,255,255,.12);
  color:white;
  border-color:rgba(255,255,255,.25);
}

.progress-circle{
  min-width:115px;
  height:115px;
  border-radius:50%;
  background:rgba(255,255,255,.13);
  border:8px solid rgba(255,255,255,.25);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
}

.progress-circle strong{
  font-size:27px;
}

.progress-circle span{
  font-size:11px;
  color:#eeeaff;
}

/* SECTIONS */
.section{
  margin-top:30px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.section-head h2{
  font-size:18px;
}

.section-head p{
  color:var(--muted);
  font-size:12px;
  margin-top:4px;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.grid-4{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

/* CARDS */
.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:15px;
  padding:18px;
  box-shadow:var(--shadow);
}

.note-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
}

.subject-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  background:#eeecff;
  color:var(--primary);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
}

.note-card h3{
  margin-top:14px;
  font-size:15px;
}

.note-card p{
  color:var(--muted);
  font-size:12px;
  margin-top:5px;
}

.progress-bar{
  height:7px;
  background:#eeeef3;
  border-radius:20px;
  overflow:hidden;
  margin-top:15px;
}

.progress-fill{
  height:100%;
  background:var(--primary);
  border-radius:20px;
}

.note-footer{
  display:flex;
  justify-content:space-between;
  margin-top:9px;
  font-size:11px;
  color:var(--muted);
}

/* TOOLS */
.tool-card{
  text-align:left;
  transition:.15s;
}

.tool-card:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 30px rgba(30,30,60,.09);
}

.tool-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  background:#f0efff;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:20px;
  margin-bottom:12px;
}

.tool-card h3{
  font-size:14px;
}

.tool-card p{
  color:var(--muted);
  font-size:11px;
  line-height:1.4;
  margin-top:5px;
}

/* DASHBOARD LOWER */
.lower-grid{
  display:grid;
  grid-template-columns:1.4fr .8fr;
  gap:18px;
}

.activity{
  display:flex;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid var(--border);
}

.activity:last-child{
  border-bottom:none;
}

.activity-icon{
  width:35px;
  height:35px;
  border-radius:10px;
  background:#f0efff;
  display:flex;
  align-items:center;
  justify-content:center;
}

.activity strong{
  font-size:13px;
}

.activity small{
  display:block;
  color:var(--muted);
  margin-top:3px;
}

/* STATS */
.stat-card{
  display:flex;
  align-items:center;
  gap:13px;
}

.stat-icon{
  width:45px;
  height:45px;
  border-radius:13px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f0efff;
  font-size:20px;
}

.stat-value{
  font-size:22px;
  font-weight:800;
}

.stat-label{
  color:var(--muted);
  font-size:11px;
  margin-top:2px;
}

/* PAGES */
.page{
  display:none;
}

.page.active{
  display:block;
}

.page-title{
  margin-bottom:25px;
}

.page-title h1{
  font-size:25px;
}

.page-title p{
  color:var(--muted);
  font-size:13px;
  margin-top:5px;
}

/* UPLOAD */
.upload-box{
  border:2px dashed #dcdbe8;
  background:#fff;
  border-radius:17px;
  padding:35px 20px;
  text-align:center;
}

.upload-icon{
  width:55px;
  height:55px;
  margin:auto;
  background:var(--primary-light);
  color:var(--primary);
  border-radius:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:25px;
}

.upload-box h2{
  font-size:18px;
  margin-top:13px;
}

.upload-box p{
  color:var(--muted);
  font-size:12px;
  margin:7px 0 17px;
}

.preview-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(120px,1fr));
  gap:10px;
  margin-top:20px;
}

.preview{
  position:relative;
  border-radius:12px;
  overflow:hidden;
  border:1px solid var(--border);
  height:120px;
}

.preview img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.preview button{
  position:absolute;
  right:6px;
  top:6px;
  width:25px;
  height:25px;
  border-radius:50%;
  background:rgba(0,0,0,.65);
  color:#fff;
}

/* FORMS */
.form-card{
  max-width:750px;
}

.form-group{
  margin-bottom:16px;
}

.form-group label{
  display:block;
  font-size:12px;
  font-weight:700;
  margin-bottom:6px;
}

.form-group input,
.form-group textarea,
.form-group select{
  width:100%;
  border:1px solid var(--border);
  border-radius:10px;
  padding:11px 12px;
  outline:none;
  background:#fff;
  font-size:13px;
}

.form-group textarea{
  min-height:110px;
  resize:vertical;
}

.form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

/* EXAMS */
.exam-card{
  position:relative;
}

.exam-date{
  color:var(--primary);
  font-size:12px;
  font-weight:700;
}

.exam-card h3{
  font-size:16px;
  margin:7px 0;
}

.exam-topic{
  color:var(--muted);
  font-size:12px;
}

.countdown{
  margin:17px 0;
  padding:13px;
  border-radius:11px;
  background:#f5f3ff;
  color:var(--primary);
  font-weight:750;
  font-size:14px;
}

.exam-actions{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

/* VOCAB */
.vocab-list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.vocab-row{
  background:white;
  border:1px solid var(--border);
  border-radius:12px;
  padding:13px;
  display:grid;
  grid-template-columns:1fr 1fr auto;
  gap:10px;
  align-items:center;
}

.vocab-word{
  font-weight:700;
}

.vocab-translation{
  color:var(--muted);
}

/* FLASHCARD */
.flashcard-wrap{
  max-width:600px;
  margin:auto;
}

.flashcard{
  height:300px;
  perspective:1000px;
  cursor:pointer;
}

.flash-inner{
  width:100%;
  height:100%;
  transition:transform .5s;
  transform-style:preserve-3d;
  position:relative;
}

.flashcard.flipped .flash-inner{
  transform:rotateY(180deg);
}

.flash-face{
  position:absolute;
  width:100%;
  height:100%;
  backface-visibility:hidden;
  border-radius:20px;
  background:#fff;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
  display:flex;
  justify-content:center;
  align-items:center;
  flex-direction:column;
  padding:25px;
  text-align:center;
}

.flash-back{
  transform:rotateY(180deg);
  background:#f6f4ff;
}

.flash-face small{
  color:var(--muted);
  margin-bottom:15px;
}

.flash-face strong{
  font-size:30px;
}

.flash-buttons{
  display:flex;
  justify-content:center;
  gap:10px;
  margin-top:15px;
}

/* TODO */
.todo-row{
  display:flex;
  align-items:center;
  gap:10px;
  padding:13px 0;
  border-bottom:1px solid var(--border);
}

.todo-row:last-child{
  border-bottom:none;
}

.todo-row input{
  width:18px;
  height:18px;
}

.todo-row.done span{
  text-decoration:line-through;
  color:#aaa;
}

.todo-delete{
  margin-left:auto;
  color:#aaa;
  background:none;
}

/* TIMER */
.timer-card{
  max-width:550px;
  margin:auto;
  text-align:center;
}

.timer-display{
  font-size:65px;
  font-weight:800;
  letter-spacing:2px;
  margin:25px 0;
}

.timer-presets{
  display:flex;
  justify-content:center;
  gap:8px;
  flex-wrap:wrap;
}

.timer-presets button{
  background:#f1f0f7;
  padding:8px 12px;
  border-radius:9px;
  font-size:12px;
}

/* EMPTY */
.empty{
  text-align:center;
  padding:45px 20px;
  color:var(--muted);
}

.empty-icon{
  font-size:38px;
  margin-bottom:10px;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  background:rgba(20,20,30,.45);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-box{
  background:#fff;
  width:100%;
  max-width:600px;
  max-height:90vh;
  overflow:auto;
  border-radius:18px;
  padding:24px;
  box-shadow:0 20px 60px rgba(0,0,0,.2);
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close{
  width:34px;
  height:34px;
  border-radius:9px;
  background:#f3f3f6;
}

/* TOAST */
.toast{
  position:fixed;
  bottom:25px;
  right:25px;
  background:#20212a;
  color:#fff;
  padding:12px 17px;
  border-radius:10px;
  font-size:13px;
  transform:translateY(100px);
  opacity:0;
  transition:.25s;
  z-index:200;
}

.toast.show{
  transform:translateY(0);
  opacity:1;
}

/* MOBILE */
.mobile-nav{
  display:none;
}

@media(max-width:1050px){
  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  .grid-4{
    grid-template-columns:repeat(2,1fr);
  }

  .lower-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:800px){
  .sidebar{
    display:none;
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .topbar{
    padding:0 15px;
  }

  .search{
    width:220px;
  }

  .content{
    padding:20px 15px 90px;
  }

  .hero{
    padding:22px;
  }

  .hero h1{
    font-size:23px;
  }

  .progress-circle{
    display:none;
  }

  .grid,
  .grid-4{
    grid-template-columns:1fr;
  }

  .mobile-nav{
    display:flex;
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    height:65px;
    background:#fff;
    border-top:1px solid var(--border);
    z-index:50;
    justify-content:space-around;
  }

  .mobile-nav button{
    background:none;
    color:#858894;
    font-size:10px;
    display:flex;
    flex-direction:column;
    gap:3px;
    align-items:center;
    justify-content:center;
  }

  .mobile-nav button.active{
    color:var(--primary);
  }

  .form-row{
    grid-template-columns:1fr;
  }

  .vocab-row{
    grid-template-columns:1fr 1fr;
  }

  .vocab-row button{
    grid-column:span 2;
  }
}

@media(max-width:500px){
  .search{
    width:170px;
  }

  .top-actions .icon-btn{
    display:none;
  }

  .hero-buttons{
    flex-direction:column;
    align-items:flex-start;
  }

  .timer-display{
    font-size:48px;
  }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar">

  <div class="logo">
    <div class="logo-icon">S</div>
    Study<span>Snap</span>
  </div>

  <div class="nav-title">Lernen</div>

  <nav class="nav">

    <button class="active" onclick="showPage('dashboard',this)">
      <span class="nav-icon">⌂</span>
      Übersicht
    </button>

    <button onclick="showPage('notes',this)">
      <span class="nav-icon">📚</span>
      Meine Lernzettel
    </button>

    <button onclick="showPage('quiz',this)">
      <span class="nav-icon">🧠</span>
      Quiz
    </button>

    <button onclick="showPage('flashcards',this)">
      <span class="nav-icon">🃏</span>
      Karteikarten
    </button>

    <button onclick="showPage('vocabulary',this)">
      <span class="nav-icon">🇬🇧</span>
      Vokabeln
    </button>

    <button onclick="showPage('questions',this)">
      <span class="nav-icon">💬</span>
      StudySnap fragen
    </button>

    <div class="nav-title" style="margin-top:22px">Planung</div>

    <button onclick="showPage('exams',this)">
      <span class="nav-icon">📅</span>
      Klassenarbeiten
    </button>

    <button onclick="showPage('tasks',this)">
      <span class="nav-icon">✓</span>
      Aufgaben
    </button>

    <button onclick="showPage('timer',this)">
      <span class="nav-icon">⏱</span>
      Lern-Timer
    </button>

  </nav>

  <div class="profile">
    <div class="avatar">C</div>
    <div>
      <div class="profile-name">Mein StudySnap</div>
      <div class="profile-small">Lernprofil</div>
    </div>
  </div>

</aside>

<main class="main">

<!-- TOPBAR -->
<header class="topbar">

  <div class="search">
    🔎
