function getCountdown(exam){

  const target =
    new Date(
      exam.date+"T"+(exam.time || "08:00")
    );

  const now =
    new Date();

  const diff =
    target-now;

  if(diff<=0){

    return "Heute / bereits vorbei";

  }

  const days =
    Math.floor(diff/(1000*60*60*24));

  const hours =
    Math.floor(
      (diff%(1000*60*60*24))
      /(1000*60*60)
    );

  if(days===0){

    return Noch ${hours} Stunde(n);

  }

  if(days===1){

    return "Noch 1 Tag";

  }

  return Noch ${days} Tage;

}

