<script>

/* =========================
   STUDYSNAP – GRUNDLOGIK
========================= */

function showToast(message){

  const toast = document.getElementById("toast");

  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 2500);
}


/* =========================
   NAVIGATION
========================= */

function selectNav(button, name){

  document
    .querySelectorAll(".nav button")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  showToast(name + " geöffnet");
}


function mobileNav(button, name){

  document
    .querySelectorAll(".mobile-nav button")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  showToast(name + " geöffnet");
}


/* =========================
   MODAL
========================= */

function openNoteModal(){

  document.getElementById("noteModal").style.display = "flex";

  document.getElementById("noteTitle").focus();
}


function closeNoteModal(){

  document.getElementById("noteModal").style.display = "none";

}


/* Klick außerhalb schließt Modal */

document.getElementById("noteModal").addEventListener("click", function(e){

  if(e.target === this){
    closeNoteModal();
  }

});


/* =========================
   LERNZETTEL SPEICHERN
========================= */

function saveNote(){

  const title =
    document.getElementById("noteTitle").value.trim();

  const content =
    document.getElementById("noteContent").value.trim();


  if(!title){

    showToast("Bitte gib einen Titel ein.");
    return;

  }


  const note = {

    id: Date.now(),

    title: title,

    content: content,

    createdAt: new Date().toLocaleDateString("de-DE")

  };


  let notes =
    JSON.parse(localStorage.getItem("studysnap_notes") || "[]");


  notes.push(note);


  localStorage.setItem(
    "studysnap_notes",
    JSON.stringify(notes)
  );


  addNoteToScreen(note);


  document.getElementById("noteTitle").value = "";
  document.getElementById("noteContent").value = "";


  closeNoteModal();


  showToast("Lernzettel wurde gespeichert ✓");

}


/* =========================
   LERNZETTEL AUF SEITE
========================= */

function addNoteToScreen(note){

  const container =
    document.getElementById("notesContainer");


  const article =
    document.createElement("article");


  article.className = "note-card";

  article.dataset.title = note.title.toLowerCase();


  article.innerHTML = `

    <div class="note-icon">📄</div>

    <h3>${escapeHTML(note.title)}</h3>

    <p>
      eigener Lernzettel · ${note.createdAt}
    </p>

    <div class="note-progress">

      <div class="note-progress-top">
        <span>Status</span>
        <span>Neu</span>
      </div>

      <div class="small-bar">
        <div
          class="small-fill"
          style="width:0%"
        ></div>
      </div>

    </div>

  `;


  container.prepend(article);

}


/* =========================
   GESPEICHERTE LERNZETTEL LADEN
========================= */

function loadSavedNotes(){

  const notes =
    JSON.parse(localStorage.getItem("studysnap_notes") || "[]");


  notes.forEach(note => {

    addNoteToScreen(note);

  });

}


/* =========================
   SUCHE
========================= */

function searchNotes(){

  const search =
    document
      .getElementById("searchInput")
      .value
      .toLowerCase();


  document
    .querySelectorAll(".note-card")
    .forEach(card => {

      const title =
        card.dataset.title || "";

      card.style.display =
        title.includes(search)
          ? ""
          : "none";

    });

}


/* =========================
   DATEI UPLOAD
========================= */

function handleFile(event){

  const file =
    event.target.files[0];


  if(!file) return;


  const allowed = [
    "image/jpeg",
    "image/png",
    "application/pdf"
  ];


  if(!allowed.includes(file.type)){

    showToast("Dieses Dateiformat wird nicht unterstützt.");
    return;

  }


  document.getElementById("noteTitle").value =
    file.name.replace(/\.[^/.]+$/, "");


  document.getElementById("noteContent").value =
    "Datei: " + file.name;


  openNoteModal();


  showToast("Datei ausgewählt ✓");

}


/* =========================
   TOOLS
========================= */

function openTool(tool){

  if(tool === "Quiz"){

    showToast("Quiz-Funktion wird vorbereitet 🧠");
    return;

  }


  if(tool === "Karteikarten"){

    showToast("Karteikarten werden vorbereitet 🗂️");
    return;

  }


  if(tool === "Zusammenfassung"){

    showToast("Zusammenfassung wird vorbereitet ✨");
    return;

  }


  if(tool === "StudySnap fragen"){

    showToast("StudySnap Fragen werden vorbereitet 💬");
    return;

  }

}


/* =========================
   SICHERER TEXT
========================= */

function escapeHTML(text){

  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


/* =========================
   START
========================= */

loadSavedNotes();

</script>

