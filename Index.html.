function getCountdown(date){

  const target =
    new Date(date+"T00:00:00");

  const now =
    new Date();

  const difference =
    target-now;

  if(difference <= 0){
    return "Heute";
  }

  const days =
    Math.ceil(
      difference / 86400000
    );

  if(days === 1){
    return "Morgen";
  }

  return "Noch " + days + " Tage";

}

